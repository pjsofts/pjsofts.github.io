      .top-nav a:hover { background: rgba(20,21,26,.06); color: var(--ink); }

      /* ---------- hero ---------- */
      .hero { position: relative; padding: 40px 0 72px; overflow: hidden; background-image: radial-gradient(rgba(20,21,26,.12) 1px, transparent 1.2px); background-size: 22px 22px; }
      .glow { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .55; pointer-events: none; }
