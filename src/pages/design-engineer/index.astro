        --sans: "Inter", ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
        --r: 14px;
        --ease: cubic-bezier(.2, .8, .2, 1);
        color-scheme: light;
      }
