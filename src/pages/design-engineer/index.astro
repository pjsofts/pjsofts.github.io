      .btn-ink:hover { transform: translateY(-2px); box-shadow: 0 1px 0 rgba(255,255,255,.18) inset, 0 18px 30px -14px rgba(20,21,26,.75); }
      .btn-ghost { border: 1px solid var(--line-2); background: rgba(255,255,255,.7); }
      .btn-ghost:hover { background: #fff; }
      .btn-light { background: var(--yellow); color: var(--ink); box-shadow: 0 12px 30px -12px rgba(246,214,74,.6); }
      .btn-light:hover { transform: translateY(-2px) rotate(-1deg); }
      .btn-sm { padding: .6em 1.1em; font-size: .88rem; }

      /* ---------- header ---------- */
      .top { position: sticky; top: 0; z-index: 100; background: rgba(243,242,238,.8); backdrop-filter: saturate(1.5) blur(14px); -webkit-backdrop-filter: saturate(1.5) blur(14px); border-bottom: 1px solid var(--line); }
      .top-in { display: flex; align-items: center; gap: 1.5rem; height: 60px; }
