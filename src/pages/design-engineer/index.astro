      body { margin: 0; background: var(--canvas); color: var(--ink); font: 400 17px/1.6 var(--sans); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      img { max-width: 100%; display: block; }
      a { color: inherit; }
      h1, h2, h3, h4, p, ul, ol, dl, dd, pre { margin: 0; }
      button { font: inherit; color: inherit; }
      .wrap { width: min(1200px, 100% - 32px); margin-inline: auto; }
      .skip { position: absolute; left: -999px; top: 8px; background: var(--ink); color: #fff; padding: 8px 12px; border-radius: 8px; z-index: 200; }
      .skip:focus { left: 8px; }
