      /* ---------- buttons ---------- */
      .btn { display: inline-flex; align-items: center; gap: .45em; padding: .9em 1.4em; border-radius: 999px; font: 600 .95rem/1 var(--sans); text-decoration: none; transition: transform .25s var(--ease), box-shadow .25s, background .2s; white-space: nowrap; }
