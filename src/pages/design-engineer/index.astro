    <script>
      const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

      // ---------- hero: Design / Code toggle ----------
      const ws = byId('ws');
      ws.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) =>
        b.addEventListener('click', () => {
          ws.dataset.mode = b.dataset.mode;
          ws.querySelectorAll('.seg button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        }),
      );

      // ---------- before / after wipe ----------
      const wipe = byId('wipe');
      const range = wipe.querySelector('input') as HTMLInputElement;
      range.addEventListener('input', () => wipe.style.setProperty('--x', `${range.value}%`));

      // ---------- playground ----------
      const inp = (id: string) => byId<HTMLInputElement>(id);
      const card = byId('pcard');
      const stage = byId('stage');
      const shadows = ['none', '0 1px 2px rgb(0 0 0 / .08)', '0 4px 12px -2px rgb(0 0 0 / .12)', '0 12px 28px -6px rgb(0 0 0 / .2)', '0 24px 48px -12px rgb(0 0 0 / .3)'];
      const twShadow = ['shadow-none', 'shadow-sm', 'shadow-md', 'shadow-lg', 'shadow-2xl'];
      const twRadius = (r: number) => (r === 0 ? 'rounded-none' : `rounded-[${r}px]`);
      const out = (id: string, v: number) => ((byId<HTMLOutputElement>(id)).value = String(v));

      function render() {
        const r = +inp('radius').value, p = +inp('pad').value, h = +inp('hue').value, s = +inp('shadow').value, dark = inp('dark').checked;
        card.style.setProperty('--r', `${r}px`);
        card.style.setProperty('--p', `${p}px`);
        card.style.setProperty('--hue', String(h));
        card.style.setProperty('--sh', shadows[s]);
        stage.classList.toggle('is-dark', dark);
        out('o-radius', r); out('o-pad', p); out('o-hue', h); out('o-shadow', s);
        const surface = dark ? `oklch(24% 0.02 ${h})` : '#ffffff';
        byId('css-out').textContent =
`:root {
  --brand: oklch(58% 0.19 ${h});
  --surface: ${surface};
}

.card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: ${p}px;
  border-radius: ${r}px;
  background: var(--surface);
  box-shadow: ${shadows[s]};
}

.card button {
  background: var(--brand);
  border-radius: ${Math.max(r - 6, 0)}px;
}`;
        byId('tw-out').textContent =
`<div class="flex flex-col gap-4
            p-[${p}px] ${twRadius(r)} ${twShadow[s]}
            bg-white dark:bg-zinc-900">
  …
  <button class="bg-[oklch(58%_0.19_${h})]
                 ${twRadius(Math.max(r - 6, 0))}">
    Ship it
  </button>
</div>`;
      }
      ['radius', 'pad', 'hue', 'shadow', 'dark'].forEach((id) => inp(id).addEventListener('input', render));
      render();

      document.querySelectorAll<HTMLButtonElement>('.tabs [role=tab]').forEach((b) =>
        b.addEventListener('click', () => {
          document.querySelectorAll('.tabs [role=tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
          byId('code-css').hidden = b.dataset.tab !== 'css';
          byId('code-tw').hidden = b.dataset.tab !== 'tw';
        }),
      );

      // ---------- syllabus: frames, inspector, connectors ----------
      const flow = byId('flow');
      const svg = document.getElementById('noodles') as unknown as SVGSVGElement;
      const frames = [...flow.querySelectorAll<HTMLButtonElement>('.wk')];
      const panels = [...document.querySelectorAll<HTMLElement>('.insp')];

      function drawNoodles() {
        const box = flow.getBoundingClientRect();
        svg.setAttribute('width', String(box.width));
        svg.setAttribute('height', String(box.height));
        svg.querySelectorAll('path.nd').forEach((p) => p.remove());
        const active = +(flow.dataset.active || 1);
        for (let i = 0; i < frames.length - 1; i++) {
          const a = frames[i].getBoundingClientRect(), b = frames[i + 1].getBoundingClientRect();
          const ax = a.left - box.left, ay = a.top - box.top, bx = b.left - box.left, by = b.top - box.top;
          let d: string;
          if (Math.abs(a.top - b.top) < 4) {
            // same row: right edge → left edge
            const x1 = ax + a.width, y1 = ay + a.height * 0.42, x2 = bx, y2 = by + b.height * 0.42, k = (x2 - x1) / 2;
            d = `M${x1} ${y1} C${x1 + k} ${y1}, ${x2 - k} ${y2}, ${x2 - 3} ${y2}`;
          } else {
            // next row: bottom centre → top centre
            const x1 = ax + a.width / 2, y1 = ay + a.height, x2 = bx + b.width / 2, y2 = by, k = Math.max((y2 - y1) * 0.9, 30);
            d = `M${x1} ${y1} C${x1} ${y1 + k}, ${x2} ${y2 - k}, ${x2} ${y2 - 3}`;
          }
          const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          p.setAttribute('d', d);
          p.setAttribute('class', `nd${i + 1 < active ? ' done' : ''}`);
          p.setAttribute('marker-end', 'url(#arrow)');
          svg.appendChild(p);
        }
      }

      function select(n: number, scroll = false) {
        frames.forEach((f) => f.setAttribute('aria-pressed', String(+f.dataset.week! === n)));
        panels.forEach((p) => (p.hidden = +p.dataset.week! !== n));
        flow.dataset.active = String(n);
        drawNoodles();
        if (scroll) byId('inspector').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      frames.forEach((f) => f.addEventListener('click', () => select(+f.dataset.week!, window.innerWidth < 760)));
      document.querySelectorAll<HTMLButtonElement>('.insp-nav [data-go]').forEach((b) =>
        b.addEventListener('click', () => select(+b.dataset.go!)),
      );
      flow.dataset.active = '1';
      // Deep links like #week-7 open that week.
      const m = location.hash.match(/^#week-(\d+)$/);
      if (m) select(+m[1]);
      new ResizeObserver(drawNoodles).observe(flow);
      document.fonts?.ready.then(drawNoodles);

      // ---------- reveal on scroll ----------
      const rv = document.querySelectorAll<HTMLElement>('.rv');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-rv');
        const io = new IntersectionObserver(
          (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        rv.forEach((el) => io.observe(el));
      }
    </script>

    <style is:global>
      @font-face { font-family: "Instrument Serif"; font-style: italic; font-weight: 400; font-display: swap; src: url("/fonts/instrument-serif-latin-400-italic.woff2") format("woff2"); }
      @font-face { font-family: "Instrument Serif"; font-style: normal; font-weight: 400; font-display: swap; src: url("/fonts/instrument-serif-latin-400-normal.woff2") format("woff2"); }

      :root {
        --canvas: #f3f2ee;
