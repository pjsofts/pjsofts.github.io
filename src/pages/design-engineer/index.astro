      .tool { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 7px; }
      .tool.on { background: var(--blue); }
      .tool svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.4; }
      .tool.on svg { fill: #fff; stroke: none; }
      .ws-file { font-size: .82rem; color: #9a9ca6; } .ws-file b { color: #fff; font-weight: 500; }
      .ws-right { display: flex; align-items: center; gap: 12px; }
      .avatars { display: flex; }
      .av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font: 700 .62rem var(--sans); color: #fff; border: 2px solid #2c2d33; margin-left: -6px; }
      .av-v { background: var(--violet); } .av-r { background: var(--red); } .av-y { background: var(--yellow); color: var(--ink); width: auto; padding: 0 7px; border-radius: 999px; }
      .seg { display: flex; background: #1d1e23; border-radius: 8px; padding: 3px; }
      .seg button { border: 0; background: none; color: #9a9ca6; font-size: .8rem; font-weight: 600; padding: .38rem .8rem; border-radius: 6px; cursor: pointer; transition: background .2s, color .2s; }
      .seg button[aria-pressed=true] { background: #fff; color: var(--ink); }

      .ws-body { display: grid; grid-template-columns: 200px minmax(0, 1fr) 220px; min-height: 560px; }
      .ws-layers, .ws-inspect { font-size: .78rem; color: var(--ink-2); padding: 14px 0; background: #fff; }
      .ws-layers { border-right: 1px solid var(--line); }
      .ws-inspect { border-left: 1px solid var(--line); padding-inline: 14px; }
      .ws-h { font-weight: 600; font-size: .74rem; color: var(--ink); padding: 0 14px 6px; margin-top: 6px; }
      .ws-inspect .ws-h { padding-inline: 0; margin-top: 14px; }
      .ws-inspect .ws-h:first-child { margin-top: 0; }
      .ws-layers ul { list-style: none; padding: 0; margin: 0 0 16px; }
      .ws-layers li { padding: 5px 14px; display: flex; gap: 8px; align-items: center; white-space: nowrap; overflow: hidden; }
      .ws-layers .ic { width: 14px; color: var(--ink-3); text-align: center; font-size: .72rem; }
      .ws-layers .lv1 { padding-left: 26px; } .ws-layers .lv2 { padding-left: 40px; }
      .ws-layers li.on { background: #e5edff; color: var(--blue); font-weight: 600; }
      .ws-layers li.on .ic { color: var(--blue); }
      .swatches { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px; }
      .swatches i { width: 22px; height: 22px; border-radius: 6px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
      .kv { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; color: var(--ink-3); }
      .kv b { font-weight: 500; color: var(--ink); background: var(--canvas); padding: 2px 7px; border-radius: 5px; display: inline-flex; align-items: center; gap: 5px; }
      .kv .sw { width: 10px; height: 10px; border-radius: 3px; background: var(--blue); }
      .ws-h-code { color: var(--blue) !important; border-top: 1px solid var(--line); padding-top: 12px !important; }
      .ws-inspect pre { font: 400 .74rem/1.7 var(--mono); color: var(--ink-2); font-variant-ligatures: none; }
      .pr { color: var(--violet); }

      .ws-canvas { position: relative; background: #f5f5f3; background-image: radial-gradient(rgba(20,21,26,.12) 1px, transparent 1.2px); background-size: 18px 18px; padding: 44px 34px 36px; }
      .frame-tag { position: absolute; top: 18px; left: 34px; font-size: .74rem; font-weight: 500; color: var(--ink-3); }
      .fl-m { display: none; }
      .stage { position: relative; background: #fff; border-radius: 6px; box-shadow: 0 0 0 1px var(--line), 0 20px 40px -30px rgba(20,21,26,.4); padding: clamp(28px, 4.5vw, 56px); min-height: 460px; display: grid; align-items: center; }
      .view-design, .view-code { grid-area: 1 / 1; transition: opacity .45s var(--ease), transform .45s var(--ease), filter .45s; }
      .view-code { opacity: 0; transform: translateY(10px) scale(.98); filter: blur(4px); pointer-events: none; background: var(--night); color: #d7dbe6; border-radius: 10px; padding: 1.4rem 1.5rem; font: 400 .86rem/1.7 var(--mono); overflow: auto; font-variant-ligatures: none; align-self: stretch; }
      .ws[data-mode=code] .view-design { opacity: 0; transform: translateY(-10px) scale(.98); filter: blur(4px); pointer-events: none; }
      .ws[data-mode=code] .view-code { opacity: 1; transform: none; filter: none; pointer-events: auto; }
      .ws[data-mode=code] .cursor { opacity: 0; }
      .view-code .tg { color: #ff8fa3; } .view-code .at { color: #ffcf70; } .view-code .st { color: #8be0b4; } .view-code .sl { color: #8fb4ff; }
      .view-code .pr { color: #c7b6ff; } .view-code .nu { color: #ffcf70; } .view-code .cm { color: #6c7183; }

      .display { font: 700 clamp(2.4rem, 5vw, 4.4rem)/.98 var(--display); letter-spacing: -0.045em; }
      .display em { font-size: 1.14em; letter-spacing: -0.02em; line-height: .9; }
      .sel { position: relative; display: inline-block; margin-top: .14em; padding: 0 .1em; outline: 1.5px solid var(--blue); outline-offset: 2px; color: var(--blue); }
      .sel .h { position: absolute; width: 9px; height: 9px; background: #fff; border: 1.5px solid var(--blue); }
      .sel .tl { top: -7px; left: -7px; } .sel .tr { top: -7px; right: -7px; } .sel .bl { bottom: -7px; left: -7px; } .sel .br { bottom: -7px; right: -7px; }
      .sel .dim { position: absolute; left: 50%; bottom: -2.1rem; transform: translateX(-50%); background: var(--blue); color: #fff; font: 600 .72rem/1 var(--sans); letter-spacing: 0; padding: 4px 7px; border-radius: 4px; white-space: nowrap; }
      .lede { font-size: clamp(1rem, 1.5vw, 1.16rem); color: var(--ink-2); max-width: 38em; margin-top: 2.6rem; }
      .lede strong { color: var(--ink); }
      .cta-row { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.8rem; }

      .cursor { position: absolute; display: flex; align-items: flex-start; pointer-events: none; z-index: 5; transition: opacity .3s; }
      .cursor svg path { stroke: #fff; stroke-width: 1.2; }
      .cursor span { margin: 14px 0 0 -2px; padding: 3px 8px; border-radius: 4px 999px 999px 999px; color: #fff; font: 600 .72rem var(--sans); white-space: nowrap; }
      .c-design svg path { fill: var(--violet); } .c-design span { background: var(--violet); }
      .c-eng svg path { fill: var(--red); } .c-eng span { background: var(--red); }
      .c-design { left: 74%; top: 86%; animation: drift-a 10s ease-in-out infinite; }
      .c-eng { left: 84%; top: 4%; animation: drift-b 12s ease-in-out infinite; }
      @keyframes drift-a { 0%,100% { transform: translate(0,0); } 30% { transform: translate(-50px, 20px); } 60% { transform: translate(40px, -30px); } }
      @keyframes drift-b { 0%,100% { transform: translate(0,0); } 40% { transform: translate(-70px, 10px); } 70% { transform: translate(10px, 20px); } }

      .facts { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 18px; }
      .facts div { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 16px 20px; display: flex; align-items: baseline; gap: .7rem; }
      .facts dt { font: 700 2rem/1 var(--display); letter-spacing: -0.03em; }
      .facts dd { font-size: .86rem; color: var(--ink-3); margin: 0; }

      /* ---------- stickers ---------- */
      .marquee { overflow: hidden; background: var(--ink); padding: 18px 0; }
      .marquee-track { display: flex; gap: 14px; width: max-content; animation: marquee 50s linear infinite; }
      .marquee:hover .marquee-track { animation-play-state: paused; }
      .stk { display: inline-block; padding: .45rem 1rem; border-radius: 999px; font: 600 .92rem var(--display); transform: rotate(var(--rot)); box-shadow: 0 2px 0 rgba(0,0,0,.25); white-space: nowrap; }
      .stk-blue { background: #dbe6ff; color: #1b46b8; } .stk-yellow { background: var(--yellow); color: var(--ink); } .stk-pink { background: #ffd3ea; color: #a5246a; }
      .stk-violet { background: #e3dcff; color: #4b2fc9; } .stk-mint { background: #c9f3df; color: #126b47; } .stk-coral { background: #ffd8cd; color: #b3391c; } .stk-ink { background: #fff; color: var(--ink); }
      @keyframes marquee { to { transform: translateX(-50%); } }

      /* ---------- sections ---------- */
      .sec { padding: clamp(72px, 10vw, 128px) 0; position: relative; }
      .sec-tint { background: var(--canvas-2); }
      .eyebrow { display: flex; align-items: center; gap: .6rem; font: 600 .78rem var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin-bottom: 1.1rem; }
      .eyebrow span { display: inline-grid; place-items: center; min-width: 2rem; height: 1.5rem; padding: 0 .4rem; border-radius: 6px; background: var(--blue); color: #fff; }
      .h2 { font: 700 clamp(2.1rem, 4.8vw, 3.8rem)/1.02 var(--display); letter-spacing: -0.04em; max-width: 16em; }
      .h2 em { color: var(--blue); font-size: 1.1em; }
      .h2-sm { font-size: clamp(1.8rem, 3.2vw, 2.6rem); }
      .sub { font-size: 1.12rem; color: var(--ink-2); max-width: 38em; margin-top: 1.1rem; }
      .sub a, .link { color: var(--blue); text-decoration: none; font-weight: 600; }

      /* reveal */
      .js-rv .rv { opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .7s var(--ease); transition-delay: var(--d, 0ms); }
      .js-rv .rv.in { opacity: 1; transform: none; }

      /* ---------- why ---------- */
      .why { display: grid; grid-template-columns: 1.25fr 1fr; gap: 16px; margin-top: 3.2rem; }
      .chart-card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 2rem; display: flex; flex-direction: column; }
      .chart-card .bars { flex: 1; align-content: center; }
      .card-k { font: 600 .76rem var(--mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
      .bars { display: grid; gap: 1.6rem; margin-top: 1.8rem; }
      .bar-row { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr) 4.5rem; gap: 1rem; align-items: center; }
      .bar-l { font-weight: 600; font-size: .95rem; }
      .bar-pair { display: grid; gap: 6px; }
      .bar { height: 26px; width: var(--w); border-radius: 6px; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; font: 600 .76rem var(--mono); transform-origin: left; }
      .js-rv .chart-card .bar { transform: scaleX(0); transition: transform 1s var(--ease) .2s; }
      .js-rv .chart-card.in .bar { transform: none; }
      .js-rv .chart-card.in .b-new { transition-delay: .45s; }
      .b-old { background: var(--canvas-2); color: var(--ink-3); }
      .b-new { background: var(--red); color: #fff; }
      .bar-d { font: 700 1.7rem var(--display); letter-spacing: -0.03em; color: var(--red); text-align: right; }
      .legend { display: flex; gap: 1.2rem; align-items: center; margin-top: 1.8rem; font-size: .84rem; color: var(--ink-3); flex-wrap: wrap; }
      .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; }
      .lg-old { background: var(--canvas-2); box-shadow: inset 0 0 0 1px var(--line-2); } .lg-new { background: var(--red); }
      .legend a { margin-left: auto; color: var(--blue); text-decoration: none; font-weight: 600; }
      .why-side { display: grid; gap: 16px; }
      .quote-card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 1.8rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; }
      .q { font: 500 1.2rem/1.4 var(--display); letter-spacing: -0.01em; }
      .q em { color: var(--blue); font-size: 1.15em; }
      .qc-dark { background: var(--night); color: #f1f2f6; border-color: transparent; }
      .qc-dark .q em { color: var(--yellow); }
      .src { font-size: .84rem; color: var(--ink-3); text-decoration: none; }
      .qc-dark .src { color: #8b90a0; }
      .src:hover { color: var(--blue); }

      .wipe { --x: 50%; position: relative; margin-top: 16px; height: 330px; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); user-select: none; }
      .wipe-pane { position: absolute; inset: 0; }
      .wipe-in { padding: 2.2rem 2.4rem; height: 100%; }
      .wipe-tag { font: 600 .76rem var(--mono); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 1.2rem; }
      .wipe ul { list-style: none; padding: 0; display: grid; gap: .75rem; font-size: 1.08rem; }
      .wipe-before { background: #e4e6ea; color: #5d6270; background-image: linear-gradient(rgba(47,107,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(47,107,255,.08) 1px, transparent 1px); background-size: 24px 24px; }
      .wipe-before .wipe-tag { color: #7d8290; }
      .wipe-before li { font-family: var(--mono); font-size: .92rem; }
      .redline { color: #e5484d; border: 1px dashed #e5484d; padding: 2px 6px; border-radius: 4px; }
      .wipe-after { clip-path: inset(0 0 0 var(--x)); background: linear-gradient(135deg, #2f6bff, #7b5cff 55%, #ff6b4a); color: #fff; }
      .wipe-after .wipe-in { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
      .wipe-after .wipe-tag { color: rgba(255,255,255,.8); }
      .wipe-after li { font: 500 1.15rem var(--display); }
      .wipe-after em { font-size: 1.2em; }
      .pr-chip { display: inline-block; background: #fff; color: #1a7f53; font: 600 .82rem var(--mono); padding: 4px 10px; border-radius: 999px; }
      .wipe-handle { position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px; background: #fff; transform: translateX(-1px); pointer-events: none; box-shadow: 0 0 0 1px rgba(20,21,26,.1); }
      .wipe-handle span { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 46px; height: 46px; border-radius: 50%; background: #fff; display: grid; place-items: center; font-size: 1.1rem; color: var(--ink); box-shadow: 0 8px 20px -6px rgba(20,21,26,.45); }
      .wipe-range { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }
      .wipe:has(.wipe-range:focus-visible) .wipe-handle span { outline: 2px solid var(--blue); outline-offset: 3px; }

      /* ---------- playground ---------- */
      .play { display: grid; grid-template-columns: 230px minmax(0, 1fr) minmax(0, 1.05fr); gap: 1rem; margin-top: 3rem; align-items: stretch; }
      .play-controls { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: .9rem 0; display: grid; gap: .2rem; align-content: start; }
      .play-controls label { display: grid; grid-template-columns: 1fr auto; gap: .3rem .5rem; padding: .5rem .9rem; font-size: .84rem; color: var(--ink-2); }
      .play-controls output { font: 500 .78rem var(--mono); background: var(--canvas); padding: .05rem .4rem; border-radius: 4px; color: var(--ink); }
      .play-controls input[type=range] { grid-column: 1 / -1; width: 100%; accent-color: var(--blue); }
      .play-controls .tog { display: flex; align-items: center; gap: .5rem; }
      .play-controls .tog input { accent-color: var(--blue); width: 16px; height: 16px; }
      .play-stage { border-radius: var(--r); border: 1px solid var(--line); display: grid; place-items: center; padding: 2rem 1.2rem; background-color: #fafaf8; background-image: radial-gradient(rgba(20,21,26,.12) 1px, transparent 1.2px); background-size: 18px 18px; transition: background-color .3s; }
      .play-stage.is-dark { background-color: #0d0e12; background-image: radial-gradient(rgba(255,255,255,.1) 1px, transparent 1.2px); }
      .pcard { --r: 16px; --p: 24px; --hue: 265; --sh: none; --brand: oklch(58% 0.19 var(--hue)); width: min(300px, 100%); display: flex; flex-direction: column; gap: 16px; padding: var(--p); border-radius: var(--r); background: #fff; color: var(--ink); box-shadow: var(--sh); transition: all .25s var(--ease); }
      .is-dark .pcard { background: oklch(24% 0.02 var(--hue)); color: #f1f2f6; border: 1px solid rgba(255,255,255,.08); }
      .pcard-top { display: flex; gap: .75rem; align-items: center; }
      .pcard-top b { display: block; font: 600 .98rem var(--display); }
      .pcard-top small { color: var(--ink-3); font-size: .8rem; }
      .is-dark .pcard-top small, .is-dark .pcard p { color: #a9aebb; }
      .pav { width: 40px; height: 40px; flex: none; border-radius: calc(var(--r) * .6 + 4px); background: oklch(93% 0.05 var(--hue)); color: var(--brand); display: grid; place-items: center; font: 700 .85rem var(--display); }
      .is-dark .pav { background: oklch(34% 0.08 var(--hue)); color: oklch(85% 0.1 var(--hue)); }
      .pcard p { font-size: .9rem; color: var(--ink-2); line-height: 1.5; }
      .pbtn { align-self: flex-start; border: 0; background: var(--brand); color: #fff; font: 600 .88rem var(--sans); padding: .7em 1.2em; border-radius: max(calc(var(--r) - 6px), 0px); cursor: pointer; transition: transform .15s, filter .15s; }
      .pbtn:hover { filter: brightness(1.08); } .pbtn:active { transform: scale(.96); }
      .play-code { background: var(--night); border-radius: var(--r); overflow: hidden; display: flex; flex-direction: column; min-width: 0; }
      .tabs { display: flex; gap: .2rem; padding: .6rem .6rem 0; border-bottom: 1px solid rgba(255,255,255,.08); }
      .tabs button { background: none; border: 0; color: #8b90a0; font: 500 .8rem var(--mono); padding: .45rem .8rem; border-radius: 6px 6px 0 0; cursor: pointer; }
      .tabs button[aria-selected=true] { color: #fff; background: rgba(255,255,255,.07); }
      .play-code pre { padding: 1rem 1.1rem; overflow: auto; font: 400 .8rem/1.6 var(--mono); color: #d7dbe6; font-variant-ligatures: none; flex: 1; }

      /* ---------- dictionary ---------- */
      .dict { list-style: none; padding: 0; margin-top: 3rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: .1rem 3rem; }
      .dict li { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
      .dict-f { font: 600 1.15rem var(--display); letter-spacing: -0.01em; white-space: nowrap; }
      .dict-line { flex: 1; position: relative; height: 2px; min-width: 2rem; }
      .dict-line i { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, var(--line-2) 0 4px, transparent 4px 8px); transition: background .2s; }
      .dict-line::before, .dict-line::after { content: ""; position: absolute; top: 50%; width: 8px; height: 8px; border-radius: 50%; transform: translateY(-50%); border: 2px solid var(--blue); background: #fff; }
      .dict-line::before { left: -4px; } .dict-line::after { right: -4px; background: var(--blue); }
      .dict li:hover .dict-line i { background: var(--blue); }
      .dict code { font: 500 .86rem var(--mono); color: var(--violet); background: rgba(123,92,255,.09); padding: .3rem .6rem; border-radius: 7px; text-align: right; }

      /* ---------- syllabus flow ---------- */
      .sec-board { background: #e9eaee; background-image: radial-gradient(rgba(20,21,26,.13) 1px, transparent 1.2px); background-size: 22px 22px; }
      .tone-blue { --tone: var(--blue); --tone-wash: #e4ecff; }
      .tone-violet { --tone: var(--violet); --tone-wash: #ece7ff; }
      .tone-coral { --tone: var(--coral); --tone-wash: #ffe7e0; }
      .tone-mint { --tone: #1fae74; --tone-wash: #dbf6e9; }
      .phase-legend { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2rem; }
      .pl { display: inline-flex; align-items: center; gap: .5rem; background: #fff; border: 1px solid var(--line); padding: .35rem .8rem; border-radius: 999px; font-size: .82rem; font-weight: 500; color: var(--ink-2); }
      .pl i { width: 10px; height: 10px; border-radius: 3px; }
      .pl-blue i { background: var(--blue); } .pl-violet i { background: var(--violet); } .pl-coral i { background: var(--coral); } .pl-mint i { background: #1fae74; }

      .flow { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 64px 44px; margin-top: 3.2rem; }
      .noodles { position: absolute; left: 0; top: 0; pointer-events: none; overflow: visible; }
      .noodles path.nd { fill: none; stroke: #9fb6f5; stroke-width: 2; stroke-dasharray: 5 5; }
      .noodles path.nd.done { stroke: var(--blue); stroke-dasharray: none; }
      .wk { position: relative; z-index: 1; text-align: left; cursor: pointer; background: #fff; border: 0; border-radius: 12px; padding: 10px 10px 14px; box-shadow: 0 0 0 1px var(--line), 0 10px 24px -18px rgba(20,21,26,.5); display: flex; flex-direction: column; gap: 8px; transition: transform .3s var(--ease), box-shadow .3s; }
      .wk:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px var(--line-2), 0 20px 34px -20px rgba(20,21,26,.55); }
      .wk[aria-pressed=true] { box-shadow: 0 0 0 2px var(--blue), 0 20px 34px -20px rgba(47,107,255,.6); }
      .wk-label { position: absolute; top: -22px; left: 2px; font: 600 .72rem var(--sans); color: var(--ink-3); }
      .wk[aria-pressed=true] .wk-label { color: var(--blue); }
      .wk-board { display: block; border-radius: 8px; background: var(--tone-wash); color: var(--tone); padding: 10px; }
      .wk-board svg { display: block; width: 100%; height: auto; }
      .wk-title { font: 600 1rem/1.2 var(--display); letter-spacing: -0.01em; padding: 0 4px; }
      .wk-map { font-size: .74rem; color: var(--ink-3); padding: 0 4px; line-height: 1.35; }
      .wk-map b { color: var(--tone); }

      .inspector { margin-top: 2.6rem; }
      .insp { background: #fff; border-radius: 20px; box-shadow: 0 0 0 1px var(--line), 0 30px 60px -40px rgba(20,21,26,.5); padding: clamp(1.4rem, 3vw, 2.4rem); animation: pop .4s var(--ease); border-top: 5px solid var(--tone); }
      @keyframes pop { from { opacity: 0; transform: translateY(8px); } }
      .insp-head { display: flex; gap: 1.4rem; align-items: flex-start; }
      .insp-n { font: 400 clamp(3.6rem, 7vw, 5.4rem)/.8 var(--serif); font-style: italic; color: var(--tone); }
      .insp-phase { font: 600 .74rem var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); }
      .insp h3 { font: 700 clamp(1.6rem, 3vw, 2.2rem)/1.1 var(--display); letter-spacing: -0.03em; margin-top: .3rem; }
      .insp-map { margin-top: .5rem; font-size: .9rem; color: var(--ink-3); }
      .insp-map b { color: var(--tone); }
      .insp-map code { font: 500 .84rem var(--mono); color: var(--ink); background: var(--tone-wash); padding: .15rem .5rem; border-radius: 5px; }
      .insp-sum { margin-top: 1.3rem; font-size: 1.08rem; color: var(--ink-2); max-width: 46em; }
      .insp-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px dashed var(--line-2); }
      .insp h4 { font: 600 .72rem var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin-bottom: .6rem; }
      .insp h4:not(:first-child) { margin-top: 1.2rem; }
      .insp ul { padding: 0; list-style: none; display: grid; gap: .5rem; }
      .insp li { padding-left: 1.4rem; position: relative; }
      .insp li::before { content: ""; position: absolute; left: 0; top: .6em; width: 8px; height: 8px; border-radius: 2px; background: var(--tone); transform: rotate(45deg); }
      .insp .ship { display: inline-block; background: var(--yellow); padding: .3rem .7rem; border-radius: 6px; font-weight: 600; }
      .insp-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 1.8rem; font: 500 .82rem var(--mono); color: var(--ink-3); }
      .insp-nav button { border: 1px solid var(--line-2); background: #fff; border-radius: 999px; padding: .5rem 1rem; cursor: pointer; font-weight: 600; font-family: var(--sans); }
      .insp-nav button:hover:not(:disabled) { background: var(--ink); color: #fff; }
      .insp-nav button:disabled { opacity: .35; cursor: default; }

      /* ---------- ships ---------- */
      .ships { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-top: 3.4rem; }
      .win { background: #fff; border-radius: 16px; box-shadow: 0 0 0 1px var(--line), 0 30px 50px -36px rgba(20,21,26,.5); overflow: hidden; transform: rotate(var(--tilt)); transition: transform .4s var(--ease), box-shadow .4s, opacity .7s var(--ease); }
      .js-rv .win.rv { transform: translateY(18px) rotate(var(--tilt)); }
      .js-rv .win.rv.in { transform: rotate(var(--tilt)); }
      .win:hover, .js-rv .win.rv.in:hover { transform: rotate(0) translateY(-6px); box-shadow: 0 0 0 1px var(--line-2), 0 40px 60px -36px rgba(20,21,26,.6); }
      .win-bar { display: flex; align-items: center; gap: 6px; padding: 10px 12px; background: #f4f4f2; border-bottom: 1px solid var(--line); }
      .win-bar i { width: 9px; height: 9px; border-radius: 50%; background: #d5d5d2; }
      .win-bar span { margin-left: 8px; flex: 1; background: #fff; border-radius: 6px; font: 500 .72rem var(--mono); color: var(--ink-3); padding: 3px 10px; }
      .win-art { height: 180px; padding: 18px; position: relative; overflow: hidden; }
      .win-txt { padding: 1.3rem 1.4rem 1.6rem; }
      .win h3 { font: 700 1.35rem var(--display); letter-spacing: -0.02em; margin-top: .6rem; }
      .win p { color: var(--ink-2); font-size: .96rem; margin-top: .4rem; }
      .tag { display: inline-block; font: 600 .7rem var(--mono); padding: .25rem .6rem; border-radius: 999px; background: var(--canvas-2); color: var(--ink-2); }
      .art-1 { background: #ece7ff; display: flex; flex-wrap: wrap; align-content: center; gap: 10px; }
      .a-btn { background: var(--violet); color: #fff; font: 600 .8rem var(--sans); padding: .55rem 1rem; border-radius: 9px; }
      .a-ghost { background: #fff; color: var(--violet); box-shadow: inset 0 0 0 1.5px var(--violet); }
      .a-tog { width: 46px; height: 26px; border-radius: 999px; background: var(--violet); position: relative; align-self: center; } .a-tog i { position: absolute; right: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; }
      .a-chip { background: var(--yellow); font: 600 .72rem var(--sans); padding: .35rem .7rem; border-radius: 999px; align-self: center; }
      .a-input { flex-basis: 100%; background: #fff; border-radius: 9px; padding: .55rem .8rem; font-size: .78rem; color: var(--ink-3); box-shadow: inset 0 0 0 1px rgba(123,92,255,.3); }
      .art-2 { background: #ffe7e0; display: grid; grid-template-columns: 50px 1fr; grid-template-rows: auto 1fr; gap: 10px; }
      .a-side { background: var(--coral); border-radius: 9px; grid-row: 1 / 3; }
      .a-main { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; } .a-main i { background: #fff; border-radius: 8px; height: 40px; }
      .a-chart { background: #fff; border-radius: 9px; display: flex; align-items: flex-end; gap: 8px; padding: 10px 14px; }
      .a-chart b { flex: 1; height: var(--h); background: var(--coral); border-radius: 4px 4px 0 0; opacity: .85; }
      .art-3 { background: #fff6cc; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
      .a-hello { font: 700 1.5rem/1.1 var(--display); letter-spacing: -0.03em; } .a-hello em { color: var(--blue); }
      .a-cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; } .a-cases i { height: 54px; border-radius: 8px; background: #fff; box-shadow: inset 0 0 0 1.5px var(--ink); }
      .a-cases i:nth-child(2) { background: var(--ink); }

      /* ---------- how + fit ---------- */
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; }
      .steps { list-style: none; padding: 0; counter-reset: s; display: grid; gap: 1.2rem; margin-top: 2rem; }
      .steps li { counter-increment: s; position: relative; padding-left: 3.4rem; color: var(--ink-2); }
      .steps li::before { content: counter(s); position: absolute; left: 0; top: -.15rem; width: 2.3rem; height: 2.3rem; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font: 400 1.3rem var(--serif); font-style: italic; }
      .steps li:not(:last-child)::after { content: ""; position: absolute; left: 1.12rem; top: 2.3rem; bottom: -1.2rem; border-left: 2px dashed var(--line-2); }
      .steps b { color: var(--ink); }
      .notes { display: grid; gap: 1.4rem; padding-top: .5rem; }
      .note { position: relative; padding: 1.6rem 1.6rem 1.7rem; border-radius: 4px 4px 22px 4px; box-shadow: 0 18px 30px -22px rgba(20,21,26,.45); }
      .note::before { content: ""; position: absolute; top: -10px; left: 50%; width: 70px; height: 20px; transform: translateX(-50%) rotate(-3deg); background: rgba(255,255,255,.6); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
      .note-y { background: #fff1a8; transform: rotate(-1.2deg); }
      .note-p { background: #ffd8e9; transform: rotate(1deg); }
      .js-rv .note-y.rv.in { transform: rotate(-1.2deg); } .js-rv .note-p.rv.in { transform: rotate(1deg); }
      .note h3 { font: 400 1.6rem var(--serif); font-style: italic; margin-bottom: .7rem; }
      .note ul { list-style: none; padding: 0; display: grid; gap: .45rem; }
      .note li { padding-left: 1.5rem; position: relative; }
      .note-y li::before { content: "✓"; position: absolute; left: 0; font-weight: 700; color: #1a7f53; }
      .note-p li::before { content: "×"; position: absolute; left: .1rem; font-weight: 700; color: #a5246a; }

      /* ---------- mentor ---------- */
      .mentor { display: flex; gap: 2.6rem; align-items: center; }
      .mentor-pic { position: relative; flex: none; }
      .mentor-pic img { width: 160px; height: 160px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 5px #fff, 0 0 0 7px var(--blue); }
      .mentor-tag { position: absolute; bottom: 4px; right: -14px; background: var(--blue); color: #fff; font: 600 .72rem var(--sans); padding: 4px 10px; border-radius: 4px 999px 999px 999px; }
      .mentor .link { display: inline-block; margin-top: 1rem; }

      /* ---------- faq ---------- */
      .faq-wrap { max-width: 880px; }
      .faq { margin-top: 2.4rem; display: grid; gap: .6rem; }
      .faq details { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 0 1.4rem; transition: box-shadow .2s; }
      .faq details[open] { box-shadow: 0 16px 30px -24px rgba(20,21,26,.5); }
      .faq summary { cursor: pointer; list-style: none; padding: 1.15rem 0; font-weight: 600; display: flex; justify-content: space-between; gap: 1rem; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: "+"; font: 400 1.5rem/1 var(--display); color: var(--blue); transition: transform .25s var(--ease); }
      .faq details[open] summary::after { transform: rotate(45deg); }
      .faq details p { padding-bottom: 1.25rem; color: var(--ink-2); }

      /* ---------- final ---------- */
      .final { position: relative; overflow: hidden; background-color: var(--night); color: #fff; padding: clamp(96px, 13vw, 160px) 0; text-align: center; background-image: radial-gradient(rgba(255,255,255,.08) 1px, transparent 1.2px), radial-gradient(60% 60% at 50% 100%, rgba(47,107,255,.35), transparent 70%); background-size: 22px 22px, 100% 100%; }
      .final-in { position: relative; display: flex; flex-direction: column; align-items: center; }
      .final-h { font: 700 clamp(3rem, 9vw, 7.6rem)/.92 var(--display); letter-spacing: -0.05em; }
      .final-h em { color: var(--yellow); font-size: 1.12em; }
      .final-p { margin: 1.6rem auto 2.2rem; max-width: 34em; color: #a9aebb; font-size: 1.08rem; }
      .fnote { position: absolute; font: 400 1.25rem/1.15 var(--serif); font-style: italic; color: var(--ink); padding: 1rem 1.2rem; border-radius: 3px 3px 16px 3px; box-shadow: 0 16px 30px -16px rgba(0,0,0,.6); text-align: left; }
      .fn1 { background: var(--pink); left: 2%; top: 8%; transform: rotate(-7deg); }
      .fn2 { background: var(--mint); right: 3%; bottom: 14%; transform: rotate(6deg); }

      .foot { background: #0b0c0f; color: #8b90a0; font-size: .88rem; padding: 1.6rem 0; }
      .foot-in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
      .foot nav { display: flex; gap: 1.4rem; flex-wrap: wrap; }
      .foot a { text-decoration: none; } .foot a:hover { color: #fff; }

      /* ---------- responsive ---------- */
      @media (max-width: 1100px) {
        .ws-body { grid-template-columns: 180px minmax(0, 1fr); }
        .ws-inspect { display: none; }
        .flow { grid-template-columns: repeat(3, 1fr); }
      }
      @media (max-width: 900px) {
        .ws-body { grid-template-columns: 1fr; min-height: 0; }
        .ws-layers, .ws-tools .tool, .ws-file { display: none; }
        .ws-canvas { padding: 38px 12px 14px; }
        .frame-tag { left: 14px; top: 14px; }
        .fl-d { display: none; } .fl-m { display: inline; }
        .stage { min-height: 0; }
        .why { grid-template-columns: 1fr; }
        .play { grid-template-columns: 1fr 1fr; }
        .play-code { grid-column: 1 / -1; }
        .dict { grid-template-columns: 1fr; }
        .facts { grid-template-columns: repeat(2, 1fr); }
        .ships { grid-template-columns: 1fr; max-width: 520px; }
        .two { grid-template-columns: 1fr; }
      }
      @media (max-width: 760px) {
        body { font-size: 16px; }
        .top-nav { display: none; }
        .top-in .btn { margin-left: auto; }
        .hero { padding-top: 28px; }
        .avatars { display: none; }
        .c-eng { display: none; }
        .c-design { left: auto; right: 8%; top: 4%; }
        .facts div { flex-direction: column; gap: .2rem; padding: 14px 16px; }
        .flow { grid-template-columns: repeat(2, 1fr); gap: 52px 26px; }
        .wipe { height: 400px; }
        .wipe-in { padding: 1.6rem 1.4rem; }
        .wipe-after ul { font-size: 1rem; }
        .bar-row { grid-template-columns: 1fr auto; }
        .bar-pair { grid-column: 1 / -1; grid-row: 2; }
        .play { grid-template-columns: 1fr; }
        .insp-grid { grid-template-columns: 1fr; }
        .insp-head { gap: 1rem; }
        .mentor { flex-direction: column; align-items: flex-start; }
        .fnote { display: none; }
        .legend a { margin-left: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
      }
    </style>
  </body>
</html>
