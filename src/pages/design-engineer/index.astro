---
// The Design Engineer course page. Standalone (not BaseLayout): it sells a
// different course to designers, so it looks like the tool they live in. The
// hero is a design workspace whose canvas flips into its own source code, and
// the syllabus is a prototype flow of frames joined by connectors.
import '../../styles/fonts.css';
import Mark from '../../components/Mark.astro';
import { SITE } from '../../data/site';
import { DE, DE_WEEKS, PHASES, DICTIONARY, DE_FAQ } from '../../data/design-engineer';

const title = 'Design Engineer Course: From UI/UX Designer to Design Engineer in 10 Weeks';
const canonical = DE.url;
const ogImage = new URL('/og-default.png', SITE.url).toString();
const phases = Object.entries(PHASES) as [keyof typeof PHASES, (typeof PHASES)[keyof typeof PHASES]][];
const pad = (n: number) => String(n).padStart(2, '0');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: DE.name,
    description: DE.description,
    url: canonical,
    inLanguage: 'en',
    provider: { '@type': 'EducationalOrganization', name: SITE.org.name, url: SITE.url, sameAs: [SITE.org.linkedin] },
    instructor: { '@type': 'Person', name: SITE.instructor.name, url: `${SITE.url}/resume/` },
    educationalLevel: 'Beginner to intermediate',
    teaches: ['HTML', 'CSS', 'Design tokens', 'JavaScript', 'TypeScript', 'React', 'Tailwind CSS', 'Motion design', 'Accessibility', 'AI coding tools'],
    syllabusSections: DE_WEEKS.map((w) => ({ '@type': 'Syllabus', name: `Week ${w.n}: ${w.title}`, description: w.summary })),
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'Online',
      courseWorkload: `PT${DE.hours}H`,
      courseSchedule: { '@type': 'Schedule', repeatFrequency: 'Weekly', repeatCount: DE.weeks, duration: `PT${DE.hours}H` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: DE_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const stickers: [string, string][] = [
  ['HTML', 'blue'], ['CSS Grid', 'yellow'], ['Flexbox', 'pink'], ['Design tokens', 'violet'], ['OKLCH', 'mint'],
  ['TypeScript', 'blue'], ['React', 'ink'], ['Next.js', 'yellow'], ['Tailwind CSS', 'mint'], ['Radix', 'pink'],
  ['shadcn/ui', 'violet'], ['Storybook', 'coral'], ['Motion', 'yellow'], ['View Transitions', 'blue'], ['WCAG 2.2', 'mint'],
  ['Figma MCP', 'violet'], ['Claude Code', 'coral'], ['Cursor', 'ink'], ['Git', 'pink'], ['Vercel', 'blue'],
];

// One small illustration per week, drawn on a 120x72 board. currentColor is the phase colour.
const ART: Record<number, string> = {
  1: `<rect x="48" y="6" width="24" height="12" rx="3" fill="currentColor"/><path d="M60 18v8M30 26h60M30 26v8M60 26v8M90 26v8" stroke="currentColor" stroke-width="2" fill="none"/><rect x="18" y="34" width="24" height="12" rx="3" fill="#fff" stroke="currentColor" stroke-width="2"/><rect x="48" y="34" width="24" height="12" rx="3" fill="#fff" stroke="currentColor" stroke-width="2"/><rect x="78" y="34" width="24" height="12" rx="3" fill="#fff" stroke="currentColor" stroke-width="2"/><path d="M60 46v8M48 54h24M48 54v6M72 54v6" stroke="currentColor" stroke-width="2" fill="none"/><rect x="40" y="60" width="16" height="8" rx="2" fill="currentColor" opacity=".4"/><rect x="64" y="60" width="16" height="8" rx="2" fill="currentColor" opacity=".4"/>`,
  2: `<rect x="10" y="8" width="62" height="26" rx="5" fill="currentColor"/><rect x="78" y="8" width="32" height="56" rx="5" fill="currentColor" opacity=".35"/><rect x="10" y="40" width="28" height="24" rx="5" fill="currentColor" opacity=".55"/><rect x="44" y="40" width="28" height="24" rx="5" fill="currentColor" opacity=".2"/><path d="M10 4h100" stroke="currentColor" stroke-dasharray="3 3" opacity=".5"/>`,
  3: `<text x="10" y="50" font-family="Instrument Serif, serif" font-style="italic" font-size="46" fill="currentColor">Aa</text><circle cx="78" cy="24" r="10" fill="currentColor"/><circle cx="100" cy="24" r="10" fill="currentColor" opacity=".55"/><circle cx="78" cy="50" r="10" fill="currentColor" opacity=".3"/><circle cx="100" cy="50" r="10" fill="#14151a"/>`,
  4: `<rect x="14" y="22" width="52" height="28" rx="14" fill="currentColor"/><circle cx="52" cy="36" r="10" fill="#fff"/><text x="76" y="44" font-family="JetBrains Mono, monospace" font-size="22" fill="currentColor">{ }</text><path d="M44 46l5 14 2.2-6 6-2.2z" fill="#14151a" stroke="#fff" stroke-width="1.2"/>`,
  5: `<path d="M60 6l14 14-14 14-14-14z" fill="currentColor"/><path d="M24 40l10 10-10 10-10-10z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M60 40l10 10-10 10-10-10z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M96 40l10 10-10 10-10-10z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M60 34v4M24 38v-4h72v4" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" fill="none"/>`,
  6: `<rect x="30" y="40" width="60" height="22" rx="6" fill="currentColor" opacity=".25"/><rect x="24" y="28" width="60" height="22" rx="6" fill="currentColor" opacity=".55"/><rect x="18" y="14" width="60" height="22" rx="6" fill="currentColor"/><text x="26" y="29" font-family="JetBrains Mono, monospace" font-size="9" fill="#fff">--brand</text><circle cx="98" cy="20" r="6" fill="#f6d64a"/>`,
  7: `<path d="M10 62 C 50 62, 46 10, 110 10" fill="none" stroke="currentColor" stroke-width="3"/><path d="M10 62L46 62M110 10L66 10" stroke="currentColor" stroke-width="1.2" opacity=".5"/><circle cx="46" cy="62" r="4" fill="#fff" stroke="currentColor" stroke-width="2"/><circle cx="66" cy="10" r="4" fill="#fff" stroke="currentColor" stroke-width="2"/><circle cx="10" cy="62" r="3" fill="currentColor"/><circle cx="110" cy="10" r="3" fill="currentColor"/>`,
  8: `<rect x="22" y="22" width="56" height="28" rx="8" fill="currentColor"/><rect x="16" y="16" width="68" height="40" rx="13" fill="none" stroke="#2f6bff" stroke-width="2.5"/><text x="34" y="41" font-family="Inter, sans-serif" font-weight="700" font-size="12" fill="#fff">Tab ⇥</text><circle cx="100" cy="36" r="11" fill="#1fa86a"/><path d="M95 36l4 4 7-8" stroke="#fff" stroke-width="2.5" fill="none"/>`,
  9: `<rect x="8" y="40" width="104" height="22" rx="11" fill="#fff" stroke="currentColor" stroke-width="2"/><text x="20" y="55" font-family="JetBrains Mono, monospace" font-size="9" fill="currentColor">hero from Figma▍</text><path d="M60 6l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" fill="currentColor"/><path d="M90 12l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="#f6d64a"/>`,
  10: `<rect x="12" y="8" width="96" height="58" rx="7" fill="#fff" stroke="currentColor" stroke-width="2"/><path d="M12 20h96" stroke="currentColor" stroke-width="2"/><circle cx="20" cy="14" r="2" fill="currentColor"/><circle cx="27" cy="14" r="2" fill="currentColor"/><circle cx="34" cy="14" r="2" fill="currentColor"/><rect x="22" y="28" width="40" height="8" rx="3" fill="currentColor"/><rect x="22" y="40" width="28" height="5" rx="2" fill="currentColor" opacity=".4"/><rect x="22" y="50" width="20" height="9" rx="4" fill="#f6d64a"/><circle cx="88" cy="44" r="12" fill="currentColor"/><path d="M82 44l4 4 8-8" stroke="#fff" stroke-width="2.5" fill="none"/>`,
};

const PHASE_TONE: Record<string, string> = { Canvas: 'blue', Systems: 'violet', Craft: 'coral', Ship: 'mint' };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={DE.description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.instructor.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={DE.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.org.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DE.description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f3f2ee" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/design-engineer/" aria-label="Design Engineer course home">
          <Mark size={30} />
          <span>Design&nbsp;Engineer</span>
        </a>
        <nav class="top-nav" aria-label="Page">
          <a href="#why">Why now</a>
          <a href="#playground">Playground</a>
          <a href="#syllabus">Syllabus</a>
          <a href="#ship">Portfolio</a>
          <a href="#faq">FAQ</a>
        </nav>
        <a class="btn btn-ink btn-sm" href={SITE.cta.href} target="_blank" rel="noopener">Apply</a>
      </div>
    </header>

    <main id="main">
      <!-- ================= HERO: a workspace ================= -->
      <section class="hero">
        <div class="glow g1" aria-hidden="true"></div>
        <div class="glow g2" aria-hidden="true"></div>

        <div class="hero-intro wrap">
          <p class="kicker"><span class="live"></span> A 10-week course for UI/UX designers</p>
        </div>

        <div class="ws wrap" id="ws" data-mode="design">
          <div class="ws-bar">
            <div class="ws-tools" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="tool on"><svg viewBox="0 0 16 16"><path d="M3 2l4.5 12 1.6-5 5-1.6z" /></svg></span>
              <span class="tool"><svg viewBox="0 0 16 16"><path d="M4 1v14M12 1v14M1 4h14M1 12h14" /></svg></span>
              <span class="tool"><svg viewBox="0 0 16 16"><rect x="2.5" y="2.5" width="11" height="11" rx="1" /></svg></span>
              <span class="tool"><svg viewBox="0 0 16 16"><path d="M3 3h10M8 3v10" /></svg></span>
              <span class="tool"><svg viewBox="0 0 16 16"><path d="M2 14c4-1 5-7 6-10l2 2c-1 3-3 6-8 8z" /></svg></span>
            </div>
            <div class="ws-file" aria-hidden="true"><span>Design Engineer</span> / <b>Hero</b></div>
            <div class="ws-right">
              <div class="avatars" aria-hidden="true"><span class="av av-v">D</span><span class="av av-r">E</span><span class="av av-y">You</span></div>
              <div class="seg" role="group" aria-label="View">
                <button type="button" data-mode="design" aria-pressed="true">Design</button>
                <button type="button" data-mode="code" aria-pressed="false">Code</button>
              </div>
            </div>
          </div>

          <div class="ws-body">
            <aside class="ws-layers" aria-hidden="true">
              <p class="ws-h">Layers</p>
              <ul>
                <li class="lv0"><span class="ic">#</span> Hero</li>
                <li class="lv1"><span class="ic">▤</span> Content</li>
                <li class="lv2"><span class="ic">T</span> Stop handing off.</li>
                <li class="lv2 on"><span class="ic">T</span> Start shipping.</li>
                <li class="lv2"><span class="ic">T</span> Lede</li>
                <li class="lv2"><span class="ic">◇</span> Button / Primary</li>
                <li class="lv2"><span class="ic">◇</span> Button / Ghost</li>
                <li class="lv1"><span class="ic">▤</span> Facts</li>
                <li class="lv1"><span class="ic">◇</span> Cursor / You</li>
              </ul>
              <p class="ws-h">Assets</p>
              <div class="swatches"><i style="background:#2f6bff"></i><i style="background:#7b5cff"></i><i style="background:#ff6b4a"></i><i style="background:#f6d64a"></i><i style="background:#2ec98a"></i><i style="background:#14151a"></i></div>
            </aside>

            <div class="ws-canvas">
              <div class="frame-tag" aria-hidden="true">Hero — <span class="fl-d">1440</span><span class="fl-m">390</span></div>
              <div class="stage">
                <div class="view-design">
                  <h1 class="display">
                    Stop handing&nbsp;off.<br />
                    <span class="sel"><em>Start shipping.</em><i class="h tl"></i><i class="h tr"></i><i class="h bl"></i><i class="h br"></i><span class="dim" aria-hidden="true">Fill × Hug</span></span>
                  </h1>
                  <p class="lede">
                    Become a <strong>design engineer</strong>: the designer who builds what they design.
                    Ten weeks from Figma to production with HTML, CSS, React, Tailwind, motion,
                    accessibility and today’s AI tools. Finish with three shipped projects, not mockups.
                  </p>
                  <div class="cta-row">
                    <a class="btn btn-ink" href={SITE.cta.href} target="_blank" rel="noopener">Apply for the next cohort <span aria-hidden="true">→</span></a>
                    <a class="btn btn-ghost" href="#syllabus">See the 10 weeks</a>
                  </div>
                </div>

                <pre class="view-code" aria-label="The same hero, as code"><code><span class="tg">&lt;section</span> <span class="at">class</span>=<span class="st">"hero"</span><span class="tg">&gt;</span>
  <span class="tg">&lt;h1&gt;</span>
    Stop handing off.
    <span class="tg">&lt;em</span> <span class="at">class</span>=<span class="st">"selected"</span><span class="tg">&gt;</span>Start shipping.<span class="tg">&lt;/em&gt;</span>
  <span class="tg">&lt;/h1&gt;</span>
  <span class="tg">&lt;Button</span> <span class="at">variant</span>=<span class="st">"primary"</span><span class="tg">&gt;</span>Apply<span class="tg">&lt;/Button&gt;</span>
<span class="tg">&lt;/section&gt;</span>

<span class="sl">.hero</span> {
  <span class="pr">display</span>: flex;          <span class="cm">/* Auto Layout */</span>
  <span class="pr">flex-direction</span>: column; <span class="cm">/* ↓ Vertical  */</span>
  <span class="pr">gap</span>: <span class="nu">var(--space-6)</span>;     <span class="cm">/* Gap 24      */</span>
  <span class="pr">padding</span>: <span class="nu">clamp(2rem, 5vw, 4rem)</span>;
}
<span class="sl">.selected</span> {
  <span class="pr">font</span>: italic <span class="nu">1em</span> <span class="st">"Instrument Serif"</span>;
  <span class="pr">color</span>: <span class="nu">var(--blue)</span>;
}</code></pre>

                <div class="cursor c-design" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18"><path d="M1 1l6.5 16 2.3-6.7L16.5 8z" /></svg>
                  <span>You, week 1</span>
                </div>
                <div class="cursor c-eng" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18"><path d="M1 1l6.5 16 2.3-6.7L16.5 8z" /></svg>
                  <span>You, week 10</span>
                </div>
              </div>
            </div>

            <aside class="ws-inspect" aria-hidden="true">
              <p class="ws-h">Auto layout</p>
              <div class="kv"><span>Direction</span><b>↓ Vertical</b></div>
              <div class="kv"><span>Gap</span><b>24</b></div>
              <div class="kv"><span>Padding</span><b>64</b></div>
              <p class="ws-h">Text</p>
              <div class="kv"><span>Font</span><b>Instrument Serif</b></div>
              <div class="kv"><span>Style</span><b>Italic · 88</b></div>
              <div class="kv"><span>Fill</span><b><i class="sw"></i>2F6BFF</b></div>
              <p class="ws-h ws-h-code">Code</p>
              <pre><code><span class="pr">gap</span>: 24px;
<span class="pr">font-style</span>: italic;
<span class="pr">color</span>: #2f6bff;</code></pre>
            </aside>
          </div>
        </div>

        <dl class="facts wrap">
          <div><dt>10</dt><dd>weeks, live cohort</dd></div>
          <div><dt>~6h</dt><dd>a week</dd></div>
          <div><dt>3</dt><dd>shipped projects</dd></div>
          <div><dt>0</dt><dd>code needed to start</dd></div>
        </dl>
      </section>

      <!-- ================= STICKERS ================= -->
      <div class="marquee" aria-label="What you will learn">
        <div class="marquee-track">
          {[...stickers, ...stickers].map(([t, c], i) => (
            <span class={`stk stk-${c}`} style={`--rot:${((i * 37) % 9) - 4}deg`} aria-hidden={i >= stickers.length ? 'true' : undefined}>{t}</span>
          ))}
        </div>
      </div>

      <!-- ================= WHY NOW ================= -->
      <section id="why" class="sec">
        <div class="wrap">
          <p class="eyebrow rv"><span>01</span> Why now</p>
          <h2 class="h2 rv">The mockup is no longer <em>the deliverable.</em></h2>
          <p class="sub rv">Pure UI roles are shrinking and the titles are changing. Teams want designers who take an idea all the way to something people can click.</p>

          <div class="why">
            <article class="chart-card rv">
              <p class="card-k">Job postings on Jobinja · Aug 2025 → Aug 2026</p>
              <div class="bars">
                <div class="bar-row">
                  <span class="bar-l">Design (category)</span>
                  <div class="bar-pair">
                    <div class="bar b-old" style="--w:100%"><span>612</span></div>
                    <div class="bar b-new" style="--w:71.6%"><span>438</span></div>
                  </div>
                  <b class="bar-d">−28%</b>
                </div>
                <div class="bar-row">
                  <span class="bar-l">Graphic designer</span>
                  <div class="bar-pair">
                    <div class="bar b-old" style="--w:72%"><span>441</span></div>
                    <div class="bar b-new" style="--w:40.5%"><span>248</span></div>
                  </div>
                  <b class="bar-d">−44%</b>
                </div>
              </div>
              <div class="legend"><span><i class="lg-old"></i>2025</span><span><i class="lg-new"></i>2026</span><a href="/blog/where-did-the-frontend-jobs-go/">How we measured →</a></div>
            </article>

            <div class="why-side">
              <article class="quote-card rv">
                <p class="q">“UI designer” and “UX designer” are fading in favour of titles like <em>product designer</em> and <em>design engineer</em>.</p>
                <a class="src" href="https://www.fastcompany.com/91543989/ai-in-design-design-jobs-2026" target="_blank" rel="noopener">Fast Company, 2026 →</a>
              </article>
              <article class="quote-card qc-dark rv">
                <p class="q">Design engineer job posts ask for React, TypeScript, Tailwind, AI coding tools, and <em>“shipped products, not just mockups.”</em></p>
                <a class="src" href="https://vercel.com/blog/design-engineering-at-vercel" target="_blank" rel="noopener">Design engineering at Vercel →</a>
              </article>
            </div>
          </div>

          <!-- before / after wipe -->
          <div class="wipe rv" id="wipe" style="--x:50%">
            <div class="wipe-pane wipe-before">
              <div class="wipe-in">
                <p class="wipe-tag">Before · UI/UX designer</p>
                <ul>
                  <li><span class="redline">Handoff spec v7 (final) (final-2).fig</span></li>
                  <li>“It looked different in Figma.”</li>
                  <li>Ticket #482: <em>button radius is 6, not 8</em></li>
                  <li>Prototype ends at click-through</li>
                  <li>Waits two sprints to see it live</li>
                </ul>
              </div>
            </div>
            <div class="wipe-pane wipe-after">
              <div class="wipe-in">
                <p class="wipe-tag">After · Design engineer</p>
                <ul>
                  <li><span class="pr-chip">✓ PR #128 merged</span></li>
                  <li>Designs in Figma <em>and</em> in code</li>
                  <li>Ships the component, the motion, the polish</li>
                  <li>Owns the design system on both sides</li>
                  <li>Steers AI tools, and knows when they’re wrong</li>
                </ul>
              </div>
            </div>
            <div class="wipe-handle" aria-hidden="true"><span>⇆</span></div>
            <input class="wipe-range" type="range" min="0" max="100" value="50" aria-label="Compare before and after" />
          </div>
        </div>
      </section>

      <!-- ================= PLAYGROUND ================= -->
      <section id="playground" class="sec sec-tint">
        <div class="wrap">
          <p class="eyebrow rv"><span>02</span> You already think in code</p>
          <h2 class="h2 rv">Your properties panel is CSS <em>with a nicer face.</em></h2>
          <p class="sub rv">Drag the sliders. Every change you would make in Figma is one line of code. By Week 3 you write these yourself.</p>

          <div class="play rv">
            <div class="play-controls" role="group" aria-label="Component properties">
              <p class="ws-h">Properties</p>
              <label>Radius <output id="o-radius">16</output><input id="radius" type="range" min="0" max="32" value="16" /></label>
              <label>Padding <output id="o-pad">24</output><input id="pad" type="range" min="8" max="48" step="4" value="24" /></label>
              <label>Hue <output id="o-hue">265</output><input id="hue" type="range" min="0" max="360" value="265" /></label>
              <label>Shadow <output id="o-shadow">2</output><input id="shadow" type="range" min="0" max="4" value="2" /></label>
              <label class="tog"><input id="dark" type="checkbox" /> Dark mode</label>
            </div>

            <div class="play-stage" id="stage">
              <div class="pcard" id="pcard">
                <div class="pcard-top">
                  <span class="pav">DE</span>
                  <div><b>Week 6 build</b><small>Design system · v1.0</small></div>
                </div>
                <p>Eight components, tokens and docs. Mapped one-to-one to Figma.</p>
                <button type="button" class="pbtn">Ship it</button>
              </div>
            </div>

            <div class="play-code">
              <div class="tabs" role="tablist">
                <button role="tab" aria-selected="true" data-tab="css">CSS</button>
                <button role="tab" aria-selected="false" data-tab="tw">Tailwind</button>
              </div>
              <pre id="code-css"><code id="css-out"></code></pre>
              <pre id="code-tw" hidden><code id="tw-out"></code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= DICTIONARY ================= -->
      <section class="sec">
        <div class="wrap">
          <p class="eyebrow rv"><span>03</span> The translation</p>
          <h2 class="h2 rv">You are not starting <em>from zero.</em></h2>
          <p class="sub rv">Almost every idea you use in Figma has a twin in code. The course is built on that map.</p>
          <ul class="dict">
            {DICTIONARY.map(([f, c], i) => (
