---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { WEEKS } from '../../data/weeks';
import { WEEKS_FA, withEnglish } from '../../data/weeks-fa';
import { JOBS } from '../../data/jobs';

const latestJobs = JOBS.filter((j) => j.status === 'open')
  .sort((a, b) => b.posted.localeCompare(a.posted))
  .slice(0, 3);

const jobDate = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('fa-IR', {
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const foundations = WEEKS_FA.filter((w) => w.part === 'مبانی');
const clone = WEEKS_FA.filter((w) => w.part === 'ساخت کلون');

const faDigits = (n: number | string) =>
  String(n).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]);

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'مهندسی هوش مصنوعی — منتورشیپ ۱۲ هفته‌ای',
  description:
    'منتورشیپ عملی ۱۲ هفته‌ای مهندسی هوش مصنوعی. یک ایجنت کدنویس واقعی را از صفر بسازید — حلقهٔ ایجنت، تول‌کالینگ، ایوال، RAG، مهندسی کانتکست، سندباکس، حافظه و هماهنگ‌سازی چند-ایجنتی. بدون فریمورک.',
  url: `${SITE.url}/fa/`,
  inLanguage: 'fa',
  provider: { '@type': 'Person', name: SITE.instructor.name, url: SITE.instructor.linkedin },
};

const faqs = [
  {
    q: 'آیا به تجربهٔ یادگیری ماشین نیاز دارم؟',
    a: 'نه. این یک دورهٔ مهندسی است، نه پژوهشی. مدل آموزش نمی‌دهید — سیستم دور مدل‌ها می‌سازید. اگر پایتون یا تایپ‌اسکریپت را راحت می‌نویسید و APIهای HTTP را می‌فهمید، آماده‌اید.',
  },
  {
    q: 'با کدام زبان کد می‌زنم؟',
    a: 'انتخاب با شماست — هر نمونه‌کد هم به پایتون و هم به تایپ‌اسکریپت ارائه می‌شود. یک مسیر را انتخاب کنید و روی آن بمانید. از SDK رسمی و خام استفاده می‌کنیم، پس دو مسیر تقریباً یکسان خوانده می‌شوند.',
  },
  {
    q: 'چرا بدون فریمورک؟',
    a: 'چون فریمورک‌ها دقیقاً همان بخش‌هایی را پنهان می‌کنند که برای یادگیری‌شان اینجایید. حلقهٔ ایجنت حدود چهل خط کد است. وقتی خودتان یک بار نوشته باشیدش، هر فریمورکی خوانا می‌شود — و می‌توانید همان‌هایی را که به کار می‌گیرید دیباگ کنید.',
  },
  {
    q: 'هفته‌ای چقدر زمان می‌برد؟',
    a: 'حدوداً ۵ تا ۱۰ ساعت ساختِ عملی، بسته به هفته. هفتهٔ ۲ با حدود ده ساعت سنگین‌ترین است؛ بیشتر هفته‌ها حدود شش ساعت.',
  },
  {
    q: 'در پایان واقعاً چه چیزی دارم؟',
    a: 'یک ایجنت کدنویس کامل و کارا که خودتان ساخته‌اید — چت استریمی، جعبه‌ابزار کامل، جست‌وجوی معنایی کدبیس، برنامه‌ریزی، حافظه، سندباکس امن، ردیابی و هماهنگ‌سازی چند-ایجنتی. در نمونه‌کارتان می‌نشیند و می‌توانید هر خطش را توضیح بدهید.',
  },
  {
    q: 'دورهٔ گروهی است یا خودآموز؟',
    a: 'یک منتورشیپ است — جزوه‌ها، پروژه و دسترسی مستقیم به من برای بازبینی و رفع گیر را می‌گیرید. برای صحبت دربارهٔ زمان‌بندی و تناسب، در لینکدین پیام بدهید.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="مهندسی هوش مصنوعی — ساخت کلون Claude Code از صفر | منتورشیپ ۱۲ هفته‌ای"
  description="منتورشیپ عملی ۱۲ هفته‌ای مهندسی هوش مصنوعی به زبان فارسی: یک ایجنت کدنویس واقعی را از صفر بسازید — حلقهٔ ایجنت، ایوال، RAG، مهندسی کانتکست، سندباکس، حافظه و هماهنگ‌سازی چند-ایجنتی. بدون فریمورک."
  canonical="/fa/"
  lang="fa"
  schema={[courseSchema, faqSchema]}
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap hero-in">
      <span class="pill pill-gold">منتورشیپ ۱۲ هفته‌ای · پایتون / تایپ‌اسکریپت</span>
      <h1>
        ایجنت کدنویسی را بسازید<br />
        <span class="grad">که بقیه فقط استفاده‌اش می‌کنند.</span>
      </h1>
      <p class="hero-sub">
        یک منتورشیپ عملی برای مهندسانی که هوش مصنوعی را جدی گرفته‌اند. از مبانی شروع
        می‌کنیم — حلقهٔ ایجنت، ایوال، یک ران‌تایم پروداکشنی — و با یک ابزار کدنویسی واقعی
        تمام می‌کنیم که خودتان ساخته‌اید. همهٔ زیرسیستم‌ها، کد واقعی، بدون فریمورک، بدون
        سرهم‌بندی.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={SITE.cta.href} target="_blank" rel="noopener">
          در لینکدین پیام بدهید ←
        </a>
        <a class="btn btn-ghost" href="/fa/curriculum">سرفصل ۱۲ هفته را ببینید</a>
      </div>

      <div class="stats">
        <div><b>۱۲</b><span>هفته</span></div>
        <div><b>۲</b><span>مسیر · پایتون / تایپ‌اسکریپت</span></div>
        <div><b>۱</b><span>محصول واقعی شیپ‌شده</span></div>
        <div><b>۰</b><span>فریمورک</span></div>
      </div>
    </div>
  </section>

  <!-- ===================== PROBLEM ===================== -->
  <section id="course">
    <div class="wrap narrow">
      <div class="eyebrow">چرا این دوره وجود دارد</div>
      <h2>بیشتر مهندس‌ها از ابزارهای هوش مصنوعی استفاده می‌کنند. عدهٔ کمی می‌توانند یکی بسازند.</h2>
      <p>
        شکافی در این حوزه هر روز بازتر می‌شود. یک طرف، توسعه‌دهنده‌هایی که یک API صدا
        می‌زنند و یک فریمورک سیم‌کشی می‌کنند. طرف دیگر، مهندسانی که می‌فهمند بین پرامپت
        و پاسخ چه می‌گذرد — که می‌توانند حلقهٔ ایجنتِ از کنترل خارج‌شده را دیباگ کنند،
        توضیح بدهند چرا یک تول‌کال شکست خورد، هزینهٔ توکن را نصف کنند، و ثابت کنند یک
        تغییر اوضاع را بهتر کرد.
      </p>
      <p>
        تعدادشان کم است، و همان‌ها هستند که شرکت‌ها واقعاً استخدام می‌کنند. سریع‌ترین راهِ
        ورود به آن، یک آموزش دیگر نیست. ساختن خودِ آن چیز است، یک بار، درست‌وحسابی.
      </p>
      <div class="callout">
        <div class="ct">پیش‌فرض دوره</div>
        <p>
          اگر یک کلون کارا از یک ایجنت کدنویسی حرفه‌ای بسازید — همانی که هر روز
          استفاده‌اش می‌کنید — این حوزه را بهتر از تقریباً هر کسی می‌فهمید که فقط
          مصرفش می‌کند. کل دوره همین است.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== WHAT YOU BUILD ===================== -->
  <section id="outcomes" class="alt">
    <div class="wrap">
      <div class="eyebrow">پروژهٔ نهایی</div>
      <h2>تا هفتهٔ ۱۲ چه چیزی دارید</h2>
      <p class="lead-p">
        جزوه نه. یک ابزار — یک ایجنت کدنویس کامل، هر هفته یک زیرسیستم.
      </p>
      <div class="grid g3 cap-grid">
        {[
          ['⌨️', 'REPL چتِ استریمی', 'یک رابط ترمینال با اسلش‌کامند، وقفهٔ امن و کنتور هزینهٔ زنده.'],
          ['🔧', 'یک جعبه‌ابزار واقعی', 'خواندن، نوشتن، ویرایش، bash، glob و grep — پشت سیستم مجوزی که به آن اعتماد دارید.'],
          ['🗺️', 'جست‌وجوی معنایی کد', 'پایگاه‌دادهٔ برداری‌ای که خودتان نوشتید: چانکینگ، امبدینگ، ایندکس‌گیری افزایشی.'],
          ['🧠', 'مهندسی کانتکست', 'سیستم‌پرامپت سرهم‌شده، قوانین پروژه از AGENTS.md، و فشرده‌سازی‌ای که از نشست‌های طولانی جان به در می‌برد.'],
          ['📋', 'برنامه‌ریزی و خویشتن‌داری', 'پلن‌مود، لیست کارهای نگهداری‌شده، و هارنسی که تصمیم می‌گیرد «تمام» یعنی چه.'],
          ['💾', 'حافظهٔ بادوام', 'نشست‌های ازسرگیری‌پذیر، حافظهٔ میان‌پروژه‌ای، و هندآف تمیز بین روزها.'],
          ['🔒', 'یک سندباکس امن', 'محدودیت‌های تحمیلی سیستم‌عامل و حصار دایرکتوری، تا کد مدل‌نوشته نتواند آسیبی بزند.'],
          ['🔍', 'ردیابی و ایوال', 'ردیابی کامل درخواست، مشاهده‌پذیری هزینه و تأخیر، و سوئیت رگرسیونی که مال خودتان است.'],
          ['🤝', 'هماهنگ‌سازی چند-ایجنتی', 'زیرایجنت‌ها با جعبه‌ابزار محدود، اجرای موازی و ادغام تمیز.'],
        ].map(([icon, title, body]) => (
          <div class="card">
            <div class="ficon">{icon}</div>
            <h3 class="fh">{title}</h3>
            <p class="fb">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CURRICULUM ===================== -->
  <section id="curriculum">
    <div class="wrap">
      <div class="eyebrow">نقشهٔ راه</div>
      <h2>دوازده هفته، یک محصول واقعی</h2>
      <p class="lead-p">
        سه هفتهٔ اول مبانی‌ای را می‌سازد که هر مهندس هوش مصنوعی لازم دارد. نُه هفتهٔ بعد
        آن‌ها را به کلونی کارا از یک ایجنت کدنویسی حرفه‌ای تبدیل می‌کند.
      </p>

      <div class="part-hd">
        <span class="pill pill-violet">بخش اول</span>
        <div>
          <h3>مبانی</h3>
          <p>اجزای پایهٔ مهندسی مدرن هوش مصنوعی — سه هفته‌ای که بیشتر دوره‌ها هرگز به آن نمی‌رسند.</p>
        </div>
      </div>
      <div class="wk-list">
        {foundations.map((w) => (
          <a class="wk" href={`/fa/curriculum/${w.slug}`}>
            <span class="wk-n">{faDigits(withEnglish(w).n)}</span>
            <span class="wk-body">
              <span class="wk-t">{w.title} <em>· {w.subtitle}</em></span>
              <span class="wk-topics">{w.topics.slice(0, 4).join(' · ')}</span>
              <span class="wk-ship">🛠 شیپ می‌کنید: {w.ship}</span>
            </span>
            <span class="wk-arrow">←</span>
          </a>
        ))}
      </div>

      <div class="part-hd">
        <span class="pill pill-violet">بخش دوم</span>
        <div>
          <h3>ساخت کلون</h3>
          <p>هر هفته یک زیرسیستم. هر هفته ابزار شما یک قابلیت واقعی به دست می‌آورد.</p>
        </div>
      </div>
      <div class="wk-list">
        {clone.map((w) => (
          <a class="wk" href={`/fa/curriculum/${w.slug}`}>
            <span class="wk-n">{faDigits(withEnglish(w).n)}</span>
            <span class="wk-body">
              <span class="wk-t">{w.title} <em>· {w.subtitle}</em></span>
              <span class="wk-topics">{w.topics.slice(0, 4).join(' · ')}</span>
              <span class="wk-ship">🛠 شیپ می‌کنید: {w.ship}</span>
            </span>
            <span class="wk-arrow">←</span>
          </a>
        ))}
      </div>

      <div class="ctr">
        <a class="btn btn-ghost" href="/fa/curriculum">سرفصل کامل را باز کنید ←</a>
      </div>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section class="alt">
    <div class="wrap">
      <div class="eyebrow">چطور کار می‌کند</div>
      <h2>ریتم هر هفته</h2>
      <div class="grid g4">
        {[
          ['۰۱', 'جزوه را بخوانید', 'یک جزوهٔ طراحی‌شده و خودکفا برای هر هفته — مفاهیم، کد، و منطقِ پشت هر تصمیم.'],
          ['۰۲', 'خودتان بسازیدش', 'هر بخش یک نقطهٔ قابل‌اجراست. کد را خودتان تایپ می‌کنید؛ خبری از نمایشِ کپی-پیست نیست.'],
          ['۰۳', 'نسخهٔ واقعی را بکاوید', 'سورس واقعی Claude Code را باز می‌کنیم و زیرسیستم شما را با نسخهٔ پروداکشن مقایسه می‌کنیم.'],
          ['۰۴', 'ثابت کنید کار می‌کند', 'ایوال، ردیابی و اندازه‌گیری — تا بهبودها اثبات شوند، نه ادعا.'],
        ].map(([n, t, b]) => (
          <div class="step">
            <div class="step-n">{n}</div>
            <h3 class="fh">{t}</h3>
            <p class="fb">{b}</p>
          </div>
        ))}
      </div>
      <div class="callout">
        <div class="ct">🔍 درون Claude Code</div>
        <p>
          یک بخش تکرارشونده در جزوه‌ها. بعد از اینکه زیرسیستمی را ساختید، پیاده‌سازی
          واقعی Claude Code را باز می‌کنیم و تصمیم‌های یک تیم پروداکشن را می‌کاویم —
          ثابت‌هایی که انتخاب کردند، حالت‌های خاصی که به آن خوردند، کامنت‌هایی که به جا
          گذاشتند. ساختن دمو آسان است؛ فاصلهٔ دمو تا محصول دقیقاً موضوع همین بخش‌هاست.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== WHO IT'S FOR ===================== -->
  <section>
    <div class="wrap">
      <div class="eyebrow">تناسب</div>
      <h2>این دوره برای چه کسی است</h2>
      <div class="grid g2">
        <div class="card">
          <h3 class="fh ok">✅ مناسب است اگر…</h3>
          <ul class="tick">
            <li>پایتون یا تایپ‌اسکریپت را راحت می‌نویسید</li>
            <li>از یک ابزار کدنویسی هوش مصنوعی استفاده کرده‌اید و کنجکاوید چطور کار می‌کند</li>
            <li>عمق می‌خواهید، نه یک آموزش API دیگر</li>
            <li>به سمت مهندسی هوش مصنوعی می‌روید و پروژهٔ نمونه‌کار لازم دارید</li>
            <li>ساختن جزء پایه را به پیکربندی فریمورک ترجیح می‌دهید</li>
          </ul>
        </div>
        <div class="card">
          <h3 class="fh no">✋ مناسب نیست اگر…</h3>
          <ul class="tick no-tick">
            <li>می‌خواهید مدل آموزش دهید یا فاین‌تیون کنید (این سیستم‌سازی است، نه پژوهش)</li>
            <li>دنبال جریان‌های بدون کد یا صرفاً پرامپتی هستید</li>
            <li>یک قالب آماده می‌خواهید که همین آخر هفته شیپش کنید</li>
            <li>نمی‌توانید حدود ۶ ساعت در هفته برای ساختن وقت بگذارید</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== INSTRUCTOR ===================== -->
  <section class="alt">
    <div class="wrap">
      <div class="eyebrow">مدرس</div>
      <div class="inst">
        <img
          src="/headshot.jpg"
          alt="پوریا جهاندیده، مدرس"
          class="inst-img"
          width="140"
          height="140"
          loading="lazy"
        />
        <div>
          <h2>پوریا جهاندیده</h2>
          <p class="inst-role">مهندس هوش مصنوعی · سرپرست تیم مهندسی · ۱۰ سال ساخت سیستم‌های پروداکشن</p>
          <p>
            من به‌صورت حرفه‌ای ایجنت هوش مصنوعی می‌سازم — ایجنت صوتی، یک محصول هوشمند
            تهیهٔ اظهارنامهٔ مالیاتی، و ابزار یادگیری ماشین برای تصویربرداری پزشکی — و
            پیش از آن یک دهه به‌عنوان مهندس فول‌استک و سرپرست تیم در فین‌تک، تاکسی
            اینترنتی در مقیاس ۴۰ میلیون کاربر، و تجارت الکترونیک مخابراتیِ مورد استفاده
            در ۱۰٬۰۰۰ فروشگاه کار کرده‌ام.
          </p>
          <p>
            در تمام این مدت تدریس هم کرده‌ام: یک دورهٔ فول‌استک طراحی کردم و صدها
            دانشجو را در جاوااسکریپت، ری‌اکت، پایتون، لینوکس، دواپس و کوبرنتیز منتور
            کرده‌ام. این دوره همان چیزی است که آرزو می‌کردم وقتی ساخت ایجنت را شروع
            کردم وجود داشت.
          </p>
          <div class="inst-cta">
            <a class="btn btn-ghost" href="/fa/resume">رزومه و سوابق کامل</a>
            <a class="btn btn-ghost" href={SITE.instructor.linkedin} target="_blank" rel="noopener">لینکدین ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== JOBS ===================== -->
  {latestJobs.length > 0 && (
    <section id="jobs">
      <div class="wrap">
        <div class="eyebrow">استخدام</div>
        <h2>موقعیت‌هایی که ارزش دیدن دارند</h2>
        <p class="lead-p">
          موقعیت‌های مهندسی و طراحی که به آن‌ها برمی‌خورم و به نظرم ارزش اشتراک دارند. هر
          کدام به‌طور کامل روی بورد شغلی نوشته شده، تا حتی بعد از حذف آگهی اصلی خوانا بماند.
        </p>
        <div class="job-strip">
          {latestJobs.map((j) => (
            <a class="jcard" href={`/jobs/${j.slug}`}>
              <div class="jcard-hd">
                {j.logo
                  ? <img class="jlogo" src={j.logo} alt={`لوگوی ${j.company}`} width="40" height="40" loading="lazy" />
                  : <div class="jlogo ph" aria-hidden="true">{j.company.charAt(0)}</div>}
                <time class="jdate" datetime={j.posted}>{jobDate(j.posted)}</time>
              </div>
              <h3 class="jtitle">{j.title}</h3>
              <p class="jco">{j.company}</p>
              <p class="jmeta">{j.arrangement}</p>
            </a>
          ))}
        </div>
        <div class="jobs-cta">
          <a class="btn btn-ghost" href="/fa/jobs">بورد کامل مشاغل ←</a>
          <a class="btn btn-ghost" href={SITE.telegram.href} target="_blank" rel="noopener">
            آگهی‌های شغلی در تلگرام ↗
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ===================== FAQ ===================== -->
  <section id="faq">
    <div class="wrap narrow">
      <div class="eyebrow">پرسش‌ها</div>
      <h2>پرسش‌های پرتکرار</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="final">
    <div class="wrap narrow ctr">
      <h2>آماده‌اید چیزی را بسازید که بقیه فقط استفاده‌اش می‌کنند؟</h2>
      <p class="final-p">
        جمعهٔ هفتهٔ ۱۲ جزوه ندارید. یک ابزار دارید — و فهم عمیقی برای توضیح هر خط آن.
      </p>
      <a class="btn btn-primary big" href={SITE.cta.href} target="_blank" rel="noopener">
        در لینکدین پیام بدهید ←
      </a>
      <p class="final-note">
        برای صحبت دربارهٔ زمان‌بندی، تناسب و هزینه پیام بدهید. به همه جواب می‌دهم.
      </p>
    </div>
  </section>
</BaseLayout>

