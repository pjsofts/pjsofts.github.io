---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CertQuiz from '../../components/CertQuiz.astro';
import { SITE } from '../../data/site';
import { CERT, QUESTIONS } from '../../data/certification';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = (await getCollection('certification')).sort((a, b) => a.data.domain - b.data.domain);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const qs = QUESTIONS.filter((q) => q.domain === d.domain);
const sections = headings.filter((h) => h.depth === 2);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Certification', item: `${SITE.url}/certification/` },
    { '@type': 'ListItem', position: 3, name: `Domain ${d.domain}`, item: `${SITE.url}/certification/${entry.id}/` },
  ],
};
---

<BaseLayout
  theme="paper"
  title={`Domain ${d.domain}: ${d.title} — ${CERT.code} Study Guide`}
  description={d.description}
  canonical={`/certification/${entry.id}`}
  schema={[breadcrumb]}
>
  <section class="pg-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/certification/">Certification</a> <span>/</span>
        <span class="cur">Domain {d.domain}</span>
      </nav>
      <span class="pill pill-gold">Domain {d.domain} · {d.weight}% of the exam · about {Math.round(d.weight * 0.6)} items</span>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
    </div>
  </section>

  <section class="body-sec">
    <div class="wrap">
      <div class="cols">
        <article class="prose main-col">
          <Content />
        </article>
        <aside class="side">
          {sections.length > 2 && (
            <nav class="toc" aria-label="On this page">
              <div class="toc-h">On this page</div>
              <ul>
                {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
                <li><a href="#practice">Practice questions</a></li>
              </ul>
            </nav>
          )}
          <div class="side-box">
            <h3>The lab</h3>
            <p>{d.lab.blurb}</p>
            <code class="cmd">python3 {d.lab.file}</code>
            <a class="btn btn-primary full" href={d.lab.url} target="_blank" rel="noopener">Open on GitHub →</a>
          </div>
        </aside>
      </div>

      <div id="practice" class="quiz-wrap">
        <CertQuiz questions={qs} heading={`Domain ${d.domain} practice`} />
        <p class="more">More: <a href="/certification/practice/">all {QUESTIONS.length} questions and a timed-style mock exam</a>.</p>
      </div>

      <nav class="pager" aria-label="Domain navigation">
        {prev ? (
          <a class="pg prev" href={`/certification/${prev.id}/`}>
            <span class="pl">← Domain {prev.data.domain}</span><span class="pt">{prev.data.title}</span>
          </a>
        ) : <a class="pg prev" href="/certification/"><span class="pl">← Overview</span><span class="pt">The exam and the blueprint</span></a>}
        {next ? (
          <a class="pg next" href={`/certification/${next.id}/`}>
            <span class="pl">Domain {next.data.domain} →</span><span class="pt">{next.data.title}</span>
          </a>
        ) : <a class="pg next" href="/certification/practice/"><span class="pl">Next →</span><span class="pt">Practice quiz</span></a>}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .pg-hero { padding: 2.4rem 0 2.6rem; background: var(--paper-2); border-bottom: 1px solid var(--rule); }
  .crumbs { font-size: .82rem; color: var(--ink-soft); margin-bottom: 1.2rem; }
  .crumbs a { color: var(--violet-deep); }
  .crumbs span { margin: 0 .35rem; }
  .crumbs .cur { color: var(--ink); }
  .pg-hero h1 { margin: 1rem 0 .6rem; font-size: clamp(1.8rem, 4.4vw, 2.7rem); }
  .lede { font-size: 1.06rem; color: var(--ink-soft); max-width: 780px; margin: 0; }

  .body-sec { padding-top: 2.6rem; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 3rem; align-items: start; }
  .main-col { min-width: 0; }
  /* wide decision tables scroll inside the column instead of the page */
  .prose :global(table) { display: block; overflow-x: auto; }
  .prose :global(pre) { overflow-x: auto; }

  .side { position: sticky; top: 86px; display: flex; flex-direction: column; gap: 1rem; }
  .toc { background: var(--ink); border-radius: var(--r-lg); padding: 1.1rem 1.3rem; box-shadow: var(--lift-2); }
  .toc-h { font-size: .72rem; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); font-family: var(--mono); margin-bottom: .6rem; }
  .toc ul { list-style: none; padding: 0; margin: 0; }
  .toc li { margin-bottom: .35rem; }
  .toc a { font-size: .88rem; color: #c3bce8; }
  .toc a:hover { color: var(--gold); }
  .side-box { background: #fff; border: 1px solid var(--rule); border-radius: var(--r); padding: 1.2rem; }
  .side-box h3 { font-size: .76rem; letter-spacing: .14em; text-transform: uppercase; color: var(--violet-deep); font-family: var(--mono); margin-bottom: .6rem; }
  .side-box p { font-size: .9rem; margin-bottom: .8rem; }
  .cmd { display: block; font-size: .78rem; margin-bottom: .9rem; overflow-wrap: anywhere; }
  .btn.full { width: 100%; justify-content: center; }

  .quiz-wrap { margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--rule); }
  .more { margin-top: 1.2rem; font-size: .92rem; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3.5rem; }
  .pg { display: flex; flex-direction: column; gap: .25rem; background: #fff; border: 1px solid var(--rule); border-radius: var(--r); padding: 1rem 1.2rem; text-decoration: none; }
  .pg:hover { text-decoration: none; box-shadow: var(--lift-hover); }
  .pg.next { text-align: right; }
  .pl { font-size: .76rem; color: var(--violet-deep); font-weight: 700; letter-spacing: .08em; font-family: var(--mono); }
  .pt { font-size: .93rem; color: var(--ink); font-weight: 600; }

  @media (max-width: 960px) {
    .cols { grid-template-columns: 1fr; gap: 2rem; }
    .side { position: static; order: -1; }
    .toc { display: none; }
  }
  @media (max-width: 600px) {
    .pager { grid-template-columns: 1fr; }
    .pg.next { text-align: left; }
  }
</style>
