---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
import { SITE } from '../data/site';
import { WEEKS } from '../data/weeks';
import { JOBS } from '../data/jobs';

const latestJobs = JOBS.filter((j) => j.status === 'open')
  .sort((a, b) => b.posted.localeCompare(a.posted))
  .slice(0, 3);

const jobDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const foundations = WEEKS.filter((w) => w.part === 'Foundations');
const clone = WEEKS.filter((w) => w.part === 'Build the Clone');

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'AI Engineering — Build a Claude Code Clone From Scratch',
  description: SITE.description,
  provider: { '@type': 'Person', name: SITE.instructor.name, url: SITE.url },
  url: SITE.url,
  inLanguage: 'en',
  teaches: [
    'Agent loops and tool calling',
    'Evals and golden datasets',
    'Context engineering',
    'RAG and vector search',
    'Sandboxing and permissions',
    'Multi-agent orchestration',
  ],
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'P6H',
    instructor: { '@type': 'Person', name: SITE.instructor.name },
  },
};

const faqs = [
  {
    q: 'Do I need machine learning experience?',
    a: 'No. This is systems engineering, not research. If you can write Python or TypeScript and have called an API, you have the background. We never train a model — we build the software around one.',
  },
  {
    q: 'Which language do I write in?',
    a: 'Either. Every week ships in Python and TypeScript, and the handouts carry both. Most people pick the one they already work in and read the other for contrast.',
  },
  {
    q: 'Why no frameworks?',
    a: 'Because a framework is exactly the thing you are trying to understand. You write the agent loop, the tool dispatch, the context assembly and the eval harness yourself — and afterwards you can read any framework and know what it is doing for you.',
  },
  {
    q: 'How much time per week?',
    a: 'About six hours: a live session, the handout, and the build. The build is the part that matters and the part nobody can do for you.',
  },
  {
    q: 'What do I actually have at the end?',
    a: 'A working AI coding agent you wrote — streaming REPL, real tools, permissions, memory, RAG, sandbox, evals and sub-agents — plus the portfolio repo and the ability to explain every line of it in an interview.',
  },
  {
    q: 'Is this cohort-based or self-paced?',
    a: 'Cohort-based, with live sessions and a group. The handouts stay yours afterwards, so the material is self-paced but the accountability is not.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Nine capabilities, nine line icons. Emoji were doing this job before, which
// is why the page looked generated: they render differently on every OS and
// sit off the baseline. These are one stroke weight, one size, one palette.
const ICON: Record<string, string> = {
  repl: 'M4 6h16v12H4z M7 10l2.5 2L7 14 M12.5 14.5H16',
  tools: 'M3 9h18v10H3z M8 9V6.5A1.5 1.5 0 0 1 9.5 5h5A1.5 1.5 0 0 1 16 6.5V9 M3 13.5h18 M10.5 13.5h3',
  search: 'M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13z M20 20l-4.8-4.8',
  context: 'M4 5h16v6H4z M4 15h10v4H4z M17 15h3v4h-3z',
  plan: 'M6 4h12v16H6z M9 9h6 M9 13h6 M9 17h3',
  memory: 'M12 4c3.9 0 7 1.1 7 2.5S15.9 9 12 9 5 7.9 5 6.5 8.1 4 12 4z M5 6.5v11C5 18.9 8.1 20 12 20s7-1.1 7-2.5v-11 M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5',
  sandbox: 'M12 3l7 3.5v6c0 4-3 7-7 8.5-4-1.5-7-4.5-7-8.5v-6L12 3z M9.5 12l1.8 1.8 3.4-3.6',
  evals: 'M4 19h16 M7 15V9 M12 19V5 M17 19v-7',
  agents: 'M8 7a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z M17 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z M7 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z M8 7v4 M8 11h9v5 M8 11v5',
};

const capstone: [keyof typeof ICON, string, string, boolean][] = [
  ['repl', 'Streaming chat REPL', 'A terminal interface with slash commands, safe interrupts and a live cost meter.', true],
  ['tools', 'A real toolset', 'Read, write, edit, bash, glob and grep — behind a permission system you trust.', false],
  ['search', 'Semantic code search', 'A vector database you wrote yourself: chunking, embeddings, incremental indexing.', false],
  ['context', 'Context engineering', 'Assembled system prompts, project rules from AGENTS.md, and compaction that survives long sessions.', false],
  ['plan', 'Planning & restraint', 'Plan mode, a maintained todo list, and a harness that decides what "done" means.', false],
  ['memory', 'Durable memory', 'Resumable sessions, cross-project memory, and clean handoffs between days.', false],
  ['sandbox', 'A secure sandbox', 'OS-enforced limits and a directory jail, so model-written code cannot hurt you.', false],
  ['evals', 'Tracing & evals', 'Full request tracing, cost and latency observability, and a regression suite you own.', false],
  ['agents', 'Multi-agent orchestration', 'Sub-agents with narrow toolsets, running in parallel and merging cleanly.', false],
];

const marquee = [
  'The agent loop', 'Tool calling', 'Evals', 'Context engineering', 'RAG',
  'Sandboxing', 'Streaming', 'Permissions', 'Sub-agents', 'No frameworks',
];
---

<BaseLayout
  title="AI Engineering — Build a Claude Code Clone From Scratch | 12-Week Mentorship"
  description={SITE.description}
  canonical="/"
  theme="paper"
  schema={[courseSchema, faqSchema]}
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <span class="blob blob-violet" aria-hidden="true"></span>
    <span class="blob blob-gold" aria-hidden="true"></span>

    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="lbl lbl-gold">12-week mentorship · Python / TypeScript</span>

        <h1 class="display-1">
          Build the AI coding agent<br />
          <span class="mark-gold">everyone else just&nbsp;uses.</span>
        </h1>

        <p class="hero-sub">
          A hands-on mentorship for engineers who are serious about AI. We start at the
          agent loop and finish with a real coding tool you built yourself — every
          subsystem, real code, no frameworks, no hand-waving.
        </p>

        <div class="hero-cta">
          <a class="b b-ink" href={SITE.cta.href} target="_blank" rel="noopener">
            {SITE.cta.label} →
          </a>
          <a class="b b-plain" href="/curriculum">See the 12 weeks</a>
        </div>

        <dl class="stats">
          <div><dt>12</dt><dd>weeks</dd></div>
          <div><dt>2</dt><dd>tracks · py / ts</dd></div>
          <div><dt>1</dt><dd>real product</dd></div>
          <div><dt>0</dt><dd>frameworks</dd></div>
        </dl>
      </div>

      <!-- The motif: what you are actually building, in the place a stock
           illustration would normally go. -->
      <div class="hero-term">
        <div class="term">
          <div class="term-bar">
            <i></i><i></i><i></i><span>mycode — week 5</span>
          </div>
          <div class="term-body">
            <span class="l"><span class="u">›</span> fix the failing test in utils.ts</span>
            <span class="l"></span>
            <span class="l"><span class="v">⌕ grep_search</span> <span class="d">"parseDuration"</span></span>
            <span class="l"><span class="d">    ✔ utils.ts:12  (1ms)</span></span>
            <span class="l"><span class="v">◇ read_file</span> <span class="d">utils.ts</span></span>
            <span class="l"><span class="d">    ✔ 16 lines  [read-only]</span></span>
            <span class="l"></span>
            <span class="l"><span class="u">┌─ permission needed</span></span>
            <span class="l"><span class="u">│</span> edit_file <span class="d">utils.ts</span></span>
            <span class="l"><span class="u">│</span>   <span class="del">- total += Number(value)</span></span>
            <span class="l"><span class="u">│</span>   <span class="g">+ total += Number(value) * unit</span></span>
            <span class="l"><span class="u">└─</span> [y]es · [a]lways · [N]o <span class="cursor">▋</span></span>
          </div>
        </div>
        <p class="term-note">Week 5, your own tool, your own permission gate.</p>
      </div>
    </div>
  </section>

  <!-- ===================== MARQUEE ===================== -->
  <div class="band">
    <div class="band-track">
      <span>{marquee.map((m) => (<><b>{m}</b><i aria-hidden="true">✳</i></>))}</span>
      <span aria-hidden="true">{marquee.map((m) => (<><b>{m}</b><i>✳</i></>))}</span>
    </div>
  </div>

  <!-- ===================== PROBLEM ===================== -->
  <section id="course">
    <div class="wrap two-col">
      <div class="col-head">
        <span class="lbl">Why this exists</span>
        <h2 class="display-2">Most engineers use AI&nbsp;tools.<br />Very few can build one.</h2>
      </div>
      <div class="col-body">
        <p class="lede">
          There is a widening gap in this field. On one side, developers who call an API
          and wire up a framework. On the other, engineers who understand what happens
          between the prompt and the answer.
        </p>
        <p>
          People who can debug a runaway agent loop, explain why a tool call failed, cut a
          token bill in half, and prove a change made things better. That second group is
          small, and it is what companies are actually hiring for.
        </p>
        <p>
          The fastest way in is not another tutorial. It is building the thing yourself,
          once, properly.
        </p>
        <blockquote class="premise">
          <strong>The premise.</strong> Build a working clone of a professional AI coding
          agent — the kind you already use every day — and you will understand this field
          better than almost anyone who only consumes it. That is the entire course.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ===================== CAPSTONE ===================== -->
  <section id="outcomes" class="s-paper2">
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl lbl-violet">The capstone</span>
        <h2 class="display-2">What you have by Week&nbsp;12</h2>
        <p class="lede">Not notes. A tool — built one subsystem per week.</p>
      </div>

      <div class="bento">
        {capstone.map(([icon, title, body, wide]) => (
          <article class={`k cap ${wide ? 'cap-wide' : ''}`}>
            <svg class="ico" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              {ICON[icon].split(' M').map((d, i) => (
                <path d={i === 0 ? d : `M${d}`} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              ))}
            </svg>
            <h3>{title}</h3>
            <p>{body}</p>
            {wide && <p class="cap-meta">/help · /cost · Ctrl+C · 1,200 lines you wrote</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CURRICULUM ===================== -->
  <section id="curriculum">
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl">The roadmap</span>
        <h2 class="display-2">Twelve weeks, one real product</h2>
        <p class="lede">
          Three weeks of fundamentals most courses never reach, then nine that assemble
          them into a working clone of a professional coding agent.
        </p>
      </div>

      <div class="part-hd">
        <span class="lbl lbl-ink">Part I</span>
        <h3 class="display-3">Foundations</h3>
      </div>
      <div class="weeks">
        {foundations.map((w) => (
          <a class="wk" href={`/curriculum/${w.slug}`}>
            <span class="wk-n">{String(w.n).padStart(2, '0')}</span>
            <span class="wk-main">
              <span class="wk-t">{w.title}</span>
              <span class="wk-s">{w.subtitle}</span>
              <span class="wk-ship">Ships: {w.ship}</span>
            </span>
            <span class="wk-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="part-hd">
        <span class="lbl lbl-ink">Part II</span>
        <h3 class="display-3">Build the clone</h3>
      </div>
      <div class="weeks">
        {clone.map((w) => (
          <a class="wk" href={`/curriculum/${w.slug}`}>
            <span class="wk-n">{String(w.n).padStart(2, '0')}</span>
            <span class="wk-main">
              <span class="wk-t">{w.title}</span>
              <span class="wk-s">{w.subtitle}</span>
              <span class="wk-ship">Ships: {w.ship}</span>
            </span>
            <span class="wk-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="ctr">
        <a class="b b-plain" href="/curriculum">Open the full curriculum →</a>
      </div>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS (ink band) ===================== -->
  <section class="s-ink rhythm">
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl">How a week goes</span>
        <h2 class="display-2">Read it, build it, then read the real thing</h2>
      </div>

      <ol class="steps">
        {[
          ['01', 'Read the handout', 'A designed, self-contained handout — concepts, code, and the reasoning behind each decision.'],
          ['02', 'Build it yourself', 'Every part is a runnable checkpoint. You type the code; nothing is copy-paste theatre.'],
          ['03', 'Study the real thing', 'We open the actual Claude Code source and compare your subsystem with the production one.'],
          ['04', 'Prove it works', 'Evals, tracing and measurement — so improvements are demonstrated, not claimed.'],
        ].map(([n, t, b]) => (
          <li>
            <span class="step-n">{n}</span>
            <h3>{t}</h3>
            <p>{b}</p>
          </li>
        ))}
      </ol>

      <aside class="inside">
        <span class="lbl lbl-gold">Inside Claude Code</span>
        <p>
          A recurring feature of the handouts. After you build a subsystem we open the real
          implementation and study the decisions a production team made — the constants they
          picked, the edge cases they hit, the comments they left behind. Building a demo is
          easy. The gap between a demo and a product is exactly what those sections are about.
        </p>
      </aside>
    </div>
  </section>

  <!-- ===================== FIT ===================== -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl">Fit</span>
        <h2 class="display-2">Who this is for</h2>
      </div>
      <div class="fit">
        <article class="k k-violet">
          <h3>A good fit if you…</h3>
          <ul class="list yes">
            <li>Write Python or TypeScript comfortably</li>
            <li>Have used an AI coding tool and wondered how it works</li>
            <li>Want depth, not another API tutorial</li>
            <li>Are moving into AI engineering and need a portfolio project</li>
            <li>Prefer building the primitive over configuring the framework</li>
          </ul>
        </article>
        <article class="k k-gold">
          <h3>Not a fit if you…</h3>
          <ul class="list no">
            <li>Want to train or fine-tune models — this is systems, not research</li>
            <li>Are looking for no-code or prompt-only workflows</li>
            <li>Want a finished template to ship this weekend</li>
            <li>Cannot commit about six hours a week to building</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== INSTRUCTOR ===================== -->
  <section class="s-paper2">
    <div class="wrap inst">
      <div class="inst-photo">
        <img
          src="/headshot.jpg"
          alt={`${SITE.instructor.name}, instructor`}
          width="340"
          height="340"
          loading="lazy"
        />
        <span class="inst-badge"><Mark size={22} variant="bare" /> instructor</span>
      </div>
      <div class="inst-copy">
        <span class="lbl">Who teaches it</span>
        <h2 class="display-2">Pouria Jahandideh</h2>
        <p class="inst-role">AI Engineer · Engineering Team Lead · 10 years in production</p>
        <p>
          I build AI agents professionally — voice agents, an AI tax-preparation product, and
          ML tooling for medical imaging — and before that I spent a decade as a full-stack
          engineer and team lead across fintech, ride-hailing at 40M-user scale, and telecom
          e-commerce used in 10,000 stores.
        </p>
        <p>
          I have been teaching that whole time: a full-stack curriculum of my own, and
          hundreds of students mentored through JavaScript, React, Python, Linux, DevOps and
          Kubernetes. This course is what I wish had existed when I started building agents.
        </p>
        <div class="hero-cta">
          <a class="b b-plain" href="/resume">Full résumé</a>
          <a class="b b-plain" href={SITE.instructor.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== JOBS ===================== -->
  {latestJobs.length > 0 && (
    <section id="jobs">
      <div class="wrap">
        <div class="sec-head">
          <span class="lbl">Hiring</span>
          <h2 class="display-2">Roles worth a look</h2>
          <p class="lede">
            AI, ML and data positions I come across and think are worth sharing — written out
            in full on the board, so they stay readable after the original post disappears.
          </p>
        </div>
        <div class="jobs">
          {latestJobs.map((j) => (
            <a class="k job" href={`/jobs/${j.slug}`}>
              <div class="job-hd">
                <span class="job-logo">{j.company.charAt(0)}</span>
                <time datetime={j.posted}>{jobDate(j.posted)}</time>
              </div>
              <h3>{j.title}</h3>
              <p class="job-co">{j.company}</p>
              <p class="job-meta">{j.arrangement}</p>
            </a>
          ))}
        </div>
        <div class="hero-cta">
          <a class="b b-plain" href="/jobs">See the full board →</a>
          <a class="b b-plain" href={SITE.telegram.href} target="_blank" rel="noopener">
            Job alerts on Telegram ↗
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ===================== FAQ ===================== -->
  <section id="faq">
    <div class="wrap two-col">
      <div class="col-head">
        <span class="lbl">Questions</span>
        <h2 class="display-2">Frequently asked</h2>
      </div>
      <div class="col-body faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}<i aria-hidden="true"></i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FINAL ===================== -->
  <section class="s-ink final">
    <div class="wrap ctr">
      <h2 class="display-2">Ready to build the thing<br />everyone else just uses?</h2>
      <p>
        By Friday of Week 12 you do not have notes. You have a tool — and the understanding
        to explain every line of it.
      </p>
      <a class="b b-primary" href={SITE.cta.href} target="_blank" rel="noopener">
        {SITE.cta.label} →
      </a>
      <p class="fine">Message me about timing, fit and pricing. I reply to everyone.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    padding: 4.5rem 0 4rem;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: 3.5rem;
    align-items: center;
  }
  /* Two shapes bleeding off the edges, so the page has a horizon instead of a
     gradient. Flat brand colour, no blur, no glow. */
  .blob { position: absolute; border-radius: 50%; z-index: 0; }
  .blob-violet {
    width: 520px; height: 520px;
    background: var(--violet-wash);
    right: -160px; top: -190px;
  }
  .blob-gold {
    width: 260px; height: 260px;
    background: var(--gold-wash);
    left: -120px; bottom: -120px;
  }
  .hero-grid > * { position: relative; z-index: 1; }

  h1.display-1 {
    margin: 1.4rem 0 0;
    font-size: clamp(2.5rem, 5.4vw, 4.3rem);
    /* `balance` distributes lines evenly, which chops a highlighted clause
       into ragged pieces and breaks the marker. `pretty` only guards the
       last line. */
    text-wrap: pretty;
  }
  /* A highlighter stroke rather than a gradient — it prints, and it survives
     being screenshotted into a LinkedIn post. */
  .mark-gold {
    display: inline;
    background: linear-gradient(transparent 62%, var(--gold) 62%, var(--gold) 94%, transparent 94%);
    padding: 0 0.08em;
  }

  .hero-sub {
    font-size: 1.16rem;
    max-width: 52ch;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.2rem;
    margin: 2.8rem 0 0;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule);
  }
  .stats dt {
    font-family: var(--display);
    font-weight: 700;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--violet-deep);
  }
  .stats dd {
    margin: 0.35rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .hero-term { transform: rotate(1.1deg); }
  .term .del { color: #ff9a9a; }
  .term .cursor { color: var(--gold); animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .term-note {
    margin: 1rem 0 0;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* ---------------- marquee ---------------- */
  .band-track b { font-weight: 500; color: #e9e4ff; }
  .band-track i { font-style: normal; color: var(--gold); }

  /* ---------------- section furniture ---------------- */
  .sec-head { max-width: 60ch; margin-bottom: 2.8rem; }
  .sec-head h2 { margin: 1rem 0 0; }
  .sec-head .lede { margin-top: 1rem; }
  .lede { font-size: 1.1rem; color: var(--ink-soft); max-width: 58ch; }

  .two-col {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3.5rem;
  }
  .col-head h2 { margin-top: 1rem; position: sticky; top: 100px; }
  .col-body p { margin: 0 0 1.1em; }
  .col-body .lede { color: var(--ink); font-weight: 500; }

  .premise {
    margin: 2rem 0 0;
    padding: 1.3rem 1.5rem;
    background: var(--violet-wash);
    border: 1px solid rgba(109, 75, 208, 0.28);
    border-left: 3px solid var(--violet);
    border-radius: var(--r);
    color: var(--ink);
    font-style: normal;
  }
  .premise strong { font-family: var(--display); }

  /* ---------------- capstone bento ---------------- */
  /* Four columns, and the feature tile takes a 2x2 bite out of the corner.
     Nine cards then land in exactly twelve cells — no orphan on the last row,
     which is what a 3-column grid gives you with nine items and one wide one. */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.15rem;
  }
