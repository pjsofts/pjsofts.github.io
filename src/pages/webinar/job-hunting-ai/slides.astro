      { h: 'The practice paradox', tone: 'ink', items: ['Build with agents', 'Interview without them', 'Go deep on one coding agent'] },
    ],
    foot: 'In the kit: /mock-screen, ai-interviewer, recruiter-screen and final-round-panel.',
  },
  {
    t: 'table',
    lbl: `${S5} · Funnel & postmortems`,
    title: 'Track every application, by channel',
    head: ['Stage', 'Track', 'If it breaks here, fix'],
    rows: [
      ['Applications', 'Date, company, role, source, resume version', '—'],
      ['Screens', 'Conversion by source', 'Resume score, Screen Grade, channels'],
      ['Finals', 'Conversion from screens', 'Mock screens, weakest answers'],
      ['Offers', 'Conversion from finals', 'Defend every line'],
    ],
    foot: 'Measure conversion at each stage, by source. Move hours toward what converts, every week.',
  },
  {
    t: 'steps',
    lbl: `${S5} · Funnel & postmortems`,
    title: 'A blameless postmortem on every loss',
    steps: [
      ['Incident', 'What happened, and at which stage?'],
      ['Cause', 'The one cause you can act on.'],
      ['Fix', 'The one change, and the layer it fixes.'],
    ],
    foot: 'One incident, one cause, one fix. Then test it on the next application.',
  },
  {
    t: 'points',
    lbl: `${S5} · Four rules when the offer comes`,
    title: 'Four rules when the offer comes',
    points: [
      ['Ask for 48 hours.', '“I’m excited. Can I have 48 hours to review?”'],
      ['Get it in writing.', 'Nothing counts until it’s written down.'],
      ['Base first.', 'Then sign-on, equity and title. Don’t give the first number.'],
      ['Know your alternative', 'before you negotiate.'],
    ],
  },
  {
    t: 'table',
    lbl: `${S5} · Four rules when the offer comes`,
    title: 'Compare offers side by side',
    head: ['', 'Offer A', 'Offer B', 'Contract C'],
    rows: [
      ['Base / hourly rate', '', '', ''],
      ['Bonus · equity · sign-on', '', '', ''],
      ['Benefits and time off', '', '', ''],
      ['Full-time-equivalent total', '', '', ''],
      ['Role fit · growth · risk', '', '', ''],
    ],
    foot: 'Contract vs full-time: compare on the same basis, with benefits and unpaid time included.',
  },
  {
    t: 'steps',
    lbl: `${S5} · Running the system`,
    title: 'The weekly loop',
    steps: [
      ['Friday Setup', 'Pull in the week’s wins.'],
      ['Sync check', 'Four sources, one story.'],
      ['Funnel review', 'Find the break point.'],
      ['Postmortem', 'One per loss. Blameless.'],
      ['Reallocate', 'Toward what converts.'],
    ],
  },
  {
    t: 'points',
    lbl: `${S5} · Advice for junior engineers`,
    title: 'Advice for junior engineers',
    points: [
      ['Build visible proof.', 'One deployed project with tests and a README beats ten tutorials.'],
      ['Learn in public.', 'Write about what you build and why. It’s distribution and practice at once.'],
      ['Apply with intention.', 'One lane, a tailored resume, a referral where you can get one.'],
      ['Review the process every week.', 'The numbers tell you which layer to fix.'],
    ],
  },
  {
    t: 'statement',
    text: 'Choose one role. Improve one piece of evidence. Send one great application.',
    sub: 'Score it. Build the record. Run it every week.',
  },
  { t: 'reading' },
  { t: 'end' },
];

const N = slides.length;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
function hl(code: string) {
  return code
    .split('\n')
    .map((line) => {
      const m = line.match(/^(.*?)(#.*)$/);
      const [body, comment] = m ? [m[1], m[2]] : [line, ''];
      return `<span class="l">${esc(body)}${comment ? `<span class="d">${esc(comment)}</span>` : ''}</span>`;
    })
    .join('');
}

const refs = [
  ['Getting the job in the era of AI (workshop)', 'Jerome Hardaway, Master.dev', 'https://master.dev/workshops/getting-a-job-v4/'],
  ['ai-era-job-kit', 'Vets Who Code', KIT],
  ['Occupational Outlook Handbook', 'BLS, 2026', 'https://www.bls.gov/ooh/computer-and-information-technology/software-developers.htm'],
  ['O*NET OnLine', 'US Dept. of Labor', 'https://www.onetonline.org/'],
  ['Portfolio Checklist', 'Vets Who Code', 'https://vetswhocode.io/portfolio-checklist'],
  ['Resumes and Cover Letters', 'Harvard Extension School, 2024', 'https://careerservices.extension.harvard.edu/'],
];

const landing = `/webinar/${W.slug}`;
const title = `${W.title} — Slides | ${SITE.name}`;
const description = `The slide deck for the free ${W.title} webinar by ${SITE.instructor.name}: resume and ATS, portfolios and GitHub, LinkedIn, and AI job search tools.`;
const canonical = new URL(`${landing}/slides`, Astro.site);
const ogImage = new URL('/og/job-hunting-ai-slides.png', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.instructor.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#17132e" />
  </head>
  <body>
    <div class="viewport">
      <div class="stage" id="stage">
        {slides.map((s, i) => (
          <article
            class={`slide ${s.t === 'section' || s.t === 'statement' || s.t === 'end' ? 'is-ink' : ''} slide-${s.t}`}
            data-i={i}
            aria-label={`Slide ${i + 1} of ${N}`}
          >
            {s.t === 'title' && (
              <div class="title-body">
                <span class="lbl lbl-gold">Free webinar · {day}</span>
                <h1>Job hunting in the age of AI,<br /><span class="mark-gold">scored, not guessed.</span></h1>
                <p class="title-sub">Resume and ATS, portfolios and GitHub, LinkedIn, and the AI tools on both sides of the table.</p>
                <div class="title-by">
                  <Mark size={52} />
                  <div>
                    <strong>{SITE.instructor.name}</strong>
                    <span>pjsofts.github.io · linkedin.com/in/pouria-jahandideh</span>
                  </div>
                </div>
              </div>
            )}

            {s.t === 'section' && (
              <div class="sec-body">
                <span class="sec-n">{s.n}</span>
                <h2>{s.title}</h2>
                <p>{s.sub}</p>
              </div>
            )}

            {s.t === 'statement' && (
              <div class="stmt-body">
                <p class="stmt">{s.text}</p>
                {s.sub && <p class="stmt-sub">{s.sub}</p>}
              </div>
            )}

            {s.t === 'agenda' && (
              <>
                <header class="hd"><span class="lbl">Today</span><h2>Five sections, one system</h2></header>
                <ol class="agenda">
                  {SECTIONS.map((m) => (
                    <li>
                      <span class="ag-n">{m.n}</span>
                      <span class="ag-t">{m.title}</span>
                      <span class="ag-l">{m.topics.map((t) => t.title).join(' · ')}</span>
                    </li>
                  ))}
                </ol>
              </>
            )}

            {s.t === 'points' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <ol class={`pts ${s.points.length > 4 ? 'is-dense' : ''} ${s.points.length > 6 ? 'is-two' : ''}`}>
                  {s.points.map((p, j) => (
                    <li>
                      <span class="pt-n">{String(j + 1).padStart(2, '0')}</span>
                      {Array.isArray(p) ? (
                        <span><strong>{p[0]}</strong> <span class="pt-rest">{p[1]}</span></span>
                      ) : (
                        <span class="pt-only">{p}</span>
                      )}
                    </li>
                  ))}
                </ol>
                {s.foot && <p class="foot-note">{s.foot}</p>}
              </>
            )}

            {s.t === 'compare' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <div class="cmp" style={`--cols:${s.cols.length}`}>
                  {s.cols.map((c) => (
                    <div class={`cmp-col tone-${c.tone}`}>
                      <h3>{c.h}</h3>
                      <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
                    </div>
                  ))}
                </div>
                {s.foot && <p class="foot-note">{s.foot}</p>}
              </>
            )}

            {s.t === 'steps' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <ol class="flow" style={`--cols:${s.steps.length}`}>
                  {s.steps.map(([t, b], j) => (
                    <li>
                      <span class="fl-n">{String(j + 1).padStart(2, '0')}</span>
                      <h3>{t}</h3>
                      <p>{b}</p>
                    </li>
                  ))}
                </ol>
                {s.foot && <p class="foot-note">{s.foot}</p>}
              </>
            )}

            {s.t === 'stats' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <div class="stats" style={`--cols:${s.stats.length}`}>
                  {s.stats.map(([n, l, src]) => (
                    <div class="stat">
                      <span class="st-n">{n}</span>
                      <span class="st-l">{l}</span>
                      <span class="st-s">{src}</span>
                    </div>
                  ))}
                </div>
                {s.foot && <p class="foot-note">{s.foot}</p>}
              </>
            )}

            {s.t === 'ladder' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <ol class={`ladder ${s.rungs.length > 4 ? 'is-dense' : ''}`}>
                  {s.rungs.map(([t, b], j) => (
                    <li style={`--step:${j}`}>
                      <span class="ld-n">{String(j + 1).padStart(2, '0')}</span>
                      <strong>{t}</strong>
                      <span>{b}</span>
                    </li>
                  ))}
                </ol>
                {s.foot && <p class="foot-note">{s.foot}</p>}
              </>
            )}

            {s.t === 'table' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <table class={`tbl ${s.rows.length > 5 ? 'is-dense' : ''}`}>
                  <thead><tr>{s.head.map((h) => <th>{h}</th>)}</tr></thead>
                  <tbody>{s.rows.map((r) => <tr>{r.map((c, j) => (j === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
                </table>
                {s.foot && <p class="foot-note">{s.foot}</p>}
              </>
            )}

            {s.t === 'code' && (
              <div class="code-grid">
                <div class="code-copy">
                  <span class="lbl">{s.lbl}</span>
                  <h2>{s.title}</h2>
                  <p>{s.caption}</p>
                </div>
                <div class="term">
                  <div class="term-bar"><i></i><i></i><i></i><span>{s.file}</span></div>
                  <div class="term-body code" set:html={hl(s.code)} />
                </div>
              </div>
            )}

            {s.t === 'reading' && (
              <>
                <header class="hd"><span class="lbl">Sources</span><h2>Where this material comes from</h2></header>
                <div class="reading">
                  <ul class="refs">
                    {refs.map(([t, by, href]) => (
                      <li><a href={href} target="_blank" rel="noopener">{t}</a><span>{by}</span></li>
                    ))}
                  </ul>
                  <div class="mine">
                    <h3>Keep going</h3>
                    <ul>
                      <li><a href="/job-search-group/">The 12-week Job Search Group</a></li>
                      <li><a href="/jobs">The jobs board</a></li>
                      <li><a href={SITE.telegram.href}>Job alerts on Telegram</a></li>
                    </ul>
                  </div>
                </div>
                <p class="foot-note">Based on Jerome Hardaway’s workshop and the Vets Who Code kit, adapted from my own experience leading a team and mentoring engineers.</p>
              </>
            )}

            {s.t === 'end' && (
              <div class="end-body">
                <img class="end-logo" src="/logo.png" width="200" height="200" alt="Pouria Jahandideh — AI Academy" />
                <h2>Thank you. Questions?</h2>
                <p>Keep going after today: 100 applications a week, every Monday together, in the 12-week Job Search Group.</p>
                <ul class="end-links">
                  <li><span>site</span> pjsofts.github.io</li>
                  <li><span>linkedin</span> linkedin.com/in/pouria-jahandideh</li>
                  <li><span>email</span> {SITE.instructor.email}</li>
                  <li><span>telegram</span> {SITE.telegram.handle}</li>
                </ul>
              </div>
            )}

            {s.t !== 'title' && (
              <footer class="sfoot">
                <span class="sf-brand"><Mark size={20} variant="bare" /> {SITE.instructor.name} · {W.title}</span>
                <span class="sf-n">{String(i + 1).padStart(2, '0')} / {N}</span>
              </footer>
            )}
          </article>
        ))}
      </div>
    </div>

    <nav class="controls" aria-label="Slide controls">
      <a class="ctl-back" href={landing}>← Webinar page</a>
      <div class="ctl-mid">
        <button type="button" data-go="prev" aria-label="Previous slide">←</button>
        <span id="counter" aria-live="polite">1 / {N}</span>
        <button type="button" data-go="next" aria-label="Next slide">→</button>
      </div>
      <div class="ctl-right">
        <button type="button" data-go="full" aria-label="Full screen">⛶ <span>F</span></button>
        <button type="button" data-go="print" aria-label="Print or save as PDF">PDF</button>
      </div>
    </nav>

    <div class="progress" aria-hidden="true"><i id="bar"></i></div>

    <script>
      const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
      const counter = document.getElementById('counter')!;
      const bar = document.getElementById('bar')!;
      const N = slides.length;
      let cur = 0;

      // Slides are 1-indexed in the URL, so #12 is what the counter says.
      const fromHash = () => {
        const n = parseInt(location.hash.slice(1), 10);
        return Number.isFinite(n) ? Math.min(Math.max(n - 1, 0), N - 1) : 0;
      };

      function show(i: number) {
        cur = Math.min(Math.max(i, 0), N - 1);
        slides.forEach((s, j) => s.classList.toggle('on', j === cur));
        counter.textContent = `${cur + 1} / ${N}`;
        bar.style.width = `${((cur + 1) / N) * 100}%`;
        history.replaceState(null, '', `#${cur + 1}`);
      }

      function fit() {
        const s = Math.min(window.innerWidth / 1280, (window.innerHeight - 52) / 720);
        document.documentElement.style.setProperty('--s', String(s));
      }

      function full() {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.();
      }

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const k = e.key;
        if (['ArrowRight', 'PageDown', ' ', 'l'].includes(k)) show(cur + 1);
        else if (['ArrowLeft', 'PageUp', 'h'].includes(k)) show(cur - 1);
        else if (k === 'Home') show(0);
        else if (k === 'End') show(N - 1);
        else if (k === 'f' || k === 'F') full();
        else return;
        e.preventDefault();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
        b.addEventListener('click', () => {
          const go = b.dataset.go;
          if (go === 'next') show(cur + 1);
          else if (go === 'prev') show(cur - 1);
          else if (go === 'full') full();
          else if (go === 'print') window.print();
        }),
      );

      let x0: number | null = null;
      document.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      document.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
        x0 = null;
      });

      window.addEventListener('resize', fit);
      window.addEventListener('hashchange', () => show(fromHash()));
      fit();
      show(fromHash());
    </script>
  </body>
</html>

<style>
  /* ---------------- the frame ---------------- */
  :global(html), :global(body) { height: 100%; }
  :global(body) {
    margin: 0;
    overflow: hidden;
    background: #0b0918 !important;
  }
  .viewport {
    position: fixed;
    inset: 0 0 52px 0;
    display: grid;
    place-items: center;
  }
  .stage {
    width: 1280px;
    height: 720px;
    position: relative;
    transform: scale(var(--s, 1));
    flex: none;
  }

  /* ---------------- a slide ---------------- */
  .slide {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    padding: 64px 84px 76px;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
    --topo-ground: var(--paper);
  }
  .slide.on { display: flex; }
  .slide.is-ink { background: var(--ink); color: #d9d3f5; }

  .slide :global(.lbl) { font-size: 14px; }
  .hd { margin-bottom: 34px; }
  .hd h2, .code-copy h2 {
    margin: 14px 0 0;
    font-size: 54px;
    line-height: 1.02;
  }
  .cite {
    margin-left: 18px;
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    vertical-align: middle;
  }

  .sfoot {
    position: absolute;
    left: 84px;
    right: 84px;
    bottom: 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .sf-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--violet-deep); }
  .sf-brand :global(svg) { color: var(--violet); }
  .is-ink .sfoot { border-top-color: rgba(233, 228, 255, 0.14); color: #8e87b8; }
  .is-ink .sf-brand { color: #c3bce8; }
  .is-ink .sf-brand :global(svg) { color: var(--gold); }

  .foot-note {
    margin: auto 0 0;
    padding: 16px 22px;
    font-size: 21px;
    line-height: 1.45;
    color: var(--ink);
    background: var(--violet-wash);
    border-left: 4px solid var(--violet);
    border-radius: 8px;
  }
  .read {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 16px;
    color: var(--violet-deep) !important;
  }

  /* ---------------- title ---------------- */
  .slide-title { justify-content: center; }
  .blob { position: absolute; border-radius: 50%; }
  .blob-violet { display: none; }
  .blob-gold { display: none; }
  .title-body { position: relative; z-index: 1; }
  .slide-title h1 { margin: 28px 0 0; font-size: 104px; line-height: 0.98; }
  .mark-gold { background: linear-gradient(transparent 62%, var(--gold) 62%, var(--gold) 94%, transparent 94%); padding: 0 0.06em; }
  .title-sub { margin: 30px 0 0; font-size: 28px; max-width: 34ch; color: var(--ink-soft); }
  .title-by { display: flex; align-items: center; gap: 18px; margin-top: 56px; }
  .title-by strong { display: block; font-family: var(--display); font-size: 26px; }
  .title-by span { font-family: var(--mono); font-size: 15px; color: var(--ink-soft); }

  /* ---------------- section / statement / end ---------------- */
  .sec-body, .stmt-body, .end-body { margin: auto 0; }
  .sec-n { font-family: var(--mono); font-size: 30px; font-weight: 600; color: var(--gold); letter-spacing: 0.1em; }
  .sec-body h2 { margin: 18px 0 0; font-size: 104px; line-height: 0.98; color: #fff; }
  .sec-body p { margin: 26px 0 0; font-size: 30px; color: #a49dd0; }
  .sec-body::before {
    content: "";
    display: block;
    width: 96px;
    height: 6px;
    background: var(--gold);
    margin-bottom: 40px;
  }

  .stmt { margin: 0; font-family: var(--display); font-weight: 700; font-size: 70px; line-height: 1.06; letter-spacing: -0.03em; color: #fff; max-width: 20ch; text-wrap: balance; }
  .stmt-sub { margin: 34px 0 0; font-size: 28px; color: #a49dd0; max-width: 50ch; padding-left: 22px; border-left: 4px solid var(--gold); }

  .end-body { text-align: left; position: relative; }
  .end-logo { display: block; width: 150px; height: 150px; border-radius: 16px; margin-bottom: 30px; }
  .end-body h2 { margin: 0; font-size: 88px; color: #fff; }
  .end-body p { margin: 20px 0 0; font-size: 26px; color: #a49dd0; max-width: 44ch; }
  .end-links { list-style: none; padding: 0; margin: 40px 0 0; max-width: 1000px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 40px; font-family: var(--mono); font-size: 20px; color: #fff; }
  .end-links span { display: inline-block; width: 110px; color: var(--gold); text-transform: uppercase; font-size: 14px; letter-spacing: 0.14em; }

  /* ---------------- agenda ---------------- */
  .agenda { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .agenda li {
    display: grid;
    grid-template-columns: 64px 330px 1fr;
    align-items: baseline;
    gap: 20px;
    padding: 16px 22px;
    background: #ffffff;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--violet);
    border-radius: 10px;
  }
  .ag-n { font-family: var(--mono); font-size: 22px; font-weight: 600; color: var(--violet-deep); }
  .ag-t { font-family: var(--display); font-weight: 700; font-size: 28px; letter-spacing: -0.02em; }
