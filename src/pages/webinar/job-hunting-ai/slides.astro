---
// The Job Hunting in the Age of AI deck. Same engine as the AI Agent Workflows
// deck: a standalone page, every slide a 1280x720 stage scaled to the window,
// so what you see on a laptop is what prints and what the projector shows.
import '../../../styles/fonts.css';
import '../../../styles/global.css';
import '../../../styles/brand.css';
import Mark from '../../../components/Mark.astro';
import { SITE } from '../../../data/site';
import { W, KIT, SECTIONS, day } from '../../../data/job-hunting';

type Pair = [string, string];
type Slide =
  | { t: 'title' }
  | { t: 'section'; n: string; title: string; sub: string }
  | { t: 'statement'; text: string; sub?: string }
  | { t: 'agenda' }
  | { t: 'points'; lbl: string; title: string; points: (string | Pair)[]; foot?: string }
  | { t: 'compare'; lbl: string; title: string; cols: { h: string; tone: 'violet' | 'gold' | 'ink'; items: string[] }[]; foot?: string }
  | { t: 'steps'; lbl: string; title: string; steps: Pair[]; foot?: string }
  | { t: 'stats'; lbl: string; title: string; stats: [string, string, string][]; foot?: string }
  | { t: 'ladder'; lbl: string; title: string; rungs: Pair[]; foot?: string }
  | { t: 'table'; lbl: string; title: string; head: string[]; rows: string[][]; foot?: string }
  | { t: 'code'; lbl: string; title: string; caption: string; file: string; code: string }
  | { t: 'reading' }
  | { t: 'end' };

const S1 = '01 · Introduction';
const S2 = '02 · Resume & ATS';
const S3 = '03 · Portfolios and projects';
const S4 = '04 · LinkedIn';
const S5 = '05 · AI job search tools';

const slides: Slide[] = [
  { t: 'title' },
