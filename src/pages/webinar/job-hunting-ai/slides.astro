      ['Measure everything.', 'If you don’t track it, you can’t fix it.'],
      ['Never list what you can’t defend.', 'Every line on your resume is a potential interview question.'],
      ['Distribution beats talent.', 'The best candidate nobody sees loses to the average candidate who’s everywhere.'],
    ],
  },

