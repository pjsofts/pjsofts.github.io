---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Mark from '../../../components/Mark.astro';
import { SITE } from '../../../data/site';

import { W, KIT, SECTIONS, TOPIC_COUNT, day, dayShort } from '../../../data/job-hunting';

const slidesHref = `/webinar/${W.slug}/slides`;
const marquee = SECTIONS.flatMap((s) => s.topics.map((t) => t.title));

const rules = [
  ['Measure everything', 'Applications, replies, screens, offers, by channel. If you don’t track it, you can’t fix it.'],
  ['Never list what you can’t defend', 'Every line on your resume is a potential interview question. Use AI to sharpen what’s true, never to invent what isn’t.'],
  ['Distribution beats talent', 'The best candidate nobody sees loses to the average candidate who’s everywhere. Being visible is part of the job.'],
] as const;

const faqs = [
  { q: 'Is it really free?', a: 'Yes. No card, no upsell inside the session. The 12-week Job Search Group is linked at the bottom of this page, and that’s the only pitch.' },
  { q: 'Who is it for?', a: 'Developers who can already build and ship in at least one stack: new grads, career changers, and anyone laid off or stuck after a pile of applications with no replies.' },
  { q: 'What do I need?', a: 'Your current resume, a GitHub account and your LinkedIn profile. To follow along with the toolkit: Claude Code (or any AI assistant), Python 3.10+ and the GitHub CLI.' },
  { q: 'How do I get the link?', a: 'Message me on LinkedIn or by email. I add you to the Telegram group, and the live link and reminders go out there.' },
  { q: 'Will there be a recording?', a: 'Anything shared after the session goes out in the Telegram group.' },
  { q: 'Where does this material come from?', a: 'It is based on Jerome Hardaway’s “Getting the job in the era of AI” workshop and the open-source ai-era-job-kit from Vets Who Code, adapted from my own experience leading a team and mentoring engineers.' },
];

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${W.title} — free webinar`,
  description: 'Resume and ATS, portfolios and GitHub, LinkedIn, and AI job search tools, with the Claude Code Job Tool Kit.',
  startDate: `${W.date}T${W.start}:00${W.tzOffset}`,
  endDate: `${W.date}T${W.end}:00${W.tzOffset}`,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  isAccessibleForFree: true,
  location: { '@type': 'VirtualLocation', url: `${SITE.url}/webinar/${W.slug}` },
  organizer: { '@type': 'Person', name: SITE.instructor.name, url: SITE.url },
  performer: { '@type': 'Person', name: SITE.instructor.name },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: `${SITE.url}/webinar/${W.slug}` },
};
---

<BaseLayout
  title={`${W.title} — Free Webinar`}
  description={`A free live webinar by ${SITE.instructor.name}: resume and ATS, portfolios and GitHub, LinkedIn, and AI job search tools, with the Claude Code Job Tool Kit. ${day}, ${W.start}–${W.end} ${W.tz}.`}
  canonical={`/webinar/${W.slug}`}
  image="/og/job-hunting-ai.png"
  theme="paper"
  schema={[eventSchema]}
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="lbl lbl-gold">Free webinar · {W.where} · {W.hours} hours</span>

        <h1 class="display-1">
          Job hunting in the age of AI,<br />
          <span class="mark-gold">scored, not guessed.</span>
        </h1>

        <p class="hero-sub">
          Machines read your application first and people read it second. In this free live
          session we score your resume, portfolio, GitHub and LinkedIn the way screeners do,
          fix what they flag, and run the search as a funnel you measure, with an
          open-source Claude Code toolkit you keep using afterwards.
        </p>

        <div class="hero-cta">
          <a class="b b-ink" href={W.join.href} target="_blank" rel="noopener">{W.join.label} →</a>
          <a class="b b-plain" href={slidesHref}>See the slides</a>
        </div>

        <dl class="stats">
          <div><dt>{W.hours}</dt><dd>hours live</dd></div>
          <div><dt>{SECTIONS.length}</dt><dd>sections</dd></div>
          <div><dt>{TOPIC_COUNT}</dt><dd>topics</dd></div>
          <div><dt>0</dt><dd>cost</dd></div>
        </dl>
      </div>

      <div class="hero-term">
        <div class="term">
          <div class="term-bar"><i></i><i></i><i></i><span>webinar --info</span></div>
          <div class="term-body">
            <span class="l"><span class="u">›</span> webinar --info {W.slug}</span>
            <span class="l"></span>
            <span class="l"><span class="d">title  </span> {W.title}</span>
            <span class="l"><span class="d">when   </span> <span class="v">{day}</span></span>
            <span class="l"><span class="d">time   </span> {W.start} – {W.end} {W.tz}</span>
            <span class="l"><span class="d">where  </span> {W.where}</span>
            <span class="l"><span class="d">price  </span> <span class="g">{W.price}</span></span>
            <span class="l"><span class="d">host   </span> {SITE.instructor.name}</span>
            <span class="l"></span>
            <span class="l"><span class="u">›</span> webinar --join</span>
            <span class="l"><span class="g">✔</span> message me → added to the Telegram group</span>
            <span class="l"><span class="u">›</span> <span class="cursor">▋</span></span>
          </div>
        </div>
        <p class="term-note">{dayShort} · {W.start}–{W.end} {W.tz}</p>
      </div>
    </div>
  </section>

  <!-- ===================== MARQUEE ===================== -->
  <div class="band">
    <div class="band-track">
      <span>{marquee.map((m) => (<><b>{m}</b><i aria-hidden="true">✳</i></>))}</span>
      <span aria-hidden="true">{marquee.map((m) => (<><b>{m}</b><i>✳</i></>))}</span>
    </div>
  </div>

  <!-- ===================== RULES ===================== -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl">The thread through all {W.hours} hours</span>
        <h2 class="display-2">Three rules for the whole search</h2>
        <p class="lede">Every section comes back to these three. If a tactic breaks one of them, we drop it.</p>
      </div>
      <ol class="rules">
        {rules.map(([t, b], i) => (
          <li class="k k-flat">
            <span class="rule-n">0{i + 1}</span>
            <h3>{t}</h3>
            <p>{b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== PIPELINE ===================== -->
  <section class="s-paper2">
    <div class="wrap pipe-grid">
      <div>
        <span class="lbl lbl-violet">Who reads your resume</span>
        <h2 class="display-2">You’re not the user. You’re the product.</h2>
        <p class="lede">
          An AI-powered ATS reads your file first and grades it against the posting. A hiring
          manager reads whoever it let through. Then the dev team presses on every line. Each
          stage only sees what the one before it passed, so we write for all three, in order.
        </p>
        <div class="hero-cta">
          <a class="b b-ink" href={W.join.href} target="_blank" rel="noopener">{W.join.label} →</a>
        </div>
      </div>
      <div class="term term-nowrap">
        <div class="term-bar"><i></i><i></i><i></i><span>application --trace</span></div>
        <div class="term-body">
          <span class="l"><span class="u">›</span> application --trace</span>
          <span class="l"></span>
          <span class="l"><span class="v">1 ATS        </span> knockouts · parse · AI rank <span class="g">✔</span></span>
          <span class="l"><span class="v">2 recruiter  </span> skim · LinkedIn check     <span class="g">✔</span></span>
          <span class="l"><span class="v">3 AI screen  </span> transcript vs. rubric     <span class="g">✔</span></span>
          <span class="l"><span class="v">4 dev team   </span> defend every line         <span class="g">✔</span></span>
          <span class="l"></span>
          <span class="l"><span class="g">✔ offer</span>  <span class="d">→ ask for 48 hours</span></span>
          <span class="l"><span class="u">›</span> <span class="cursor">▋</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== AGENDA ===================== -->
  <section id="agenda">
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl lbl-violet">The agenda</span>
        <h2 class="display-2">{SECTIONS.length} sections, {TOPIC_COUNT} topics</h2>
        <p class="lede">
          We set up the toolkit, then work through each reader of your application in turn:
          the ATS, the dev team, recruiters, and the AI screeners, and finish with the funnel
          and the offer.
        </p>
      </div>

      <div class="mods">
        {SECTIONS.map((s) => (
          <article class="mod">
            <header class="mod-hd">
              <span class="mod-n">{s.n}</span>
              <div>
                <h3>{s.title}</h3>
                <p class="mod-who">{s.reader}</p>
              </div>
            </header>
            <ol class="topics">
              {s.topics.map((t) => (
                <li>
                  <span class="tp-t">{t.title}</span>
                  <span class="tp-l">{t.line}</span>
                </li>
              ))}
            </ol>
            <aside class="mod-out">
              <span class="out-lbl">You leave with</span>
              <p>{s.leave}</p>
              <span class="out-lbl">From the kit</span>
              <ul class="chips">{s.tools.map((t) => <li><code>{t}</code></li>)}</ul>
            </aside>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TOOLKIT ===================== -->
  <section class="s-ink" id="kit">
    <div class="wrap kit-grid">
      <div>
        <span class="lbl">Claude Code Job Tool Kit</span>
        <h2 class="display-2">Install it before you come</h2>
        <p>
          We work live with <a href={KIT} target="_blank" rel="noopener">ai-era-job-kit</a>, an
          open-source Claude Code plugin from Vets Who Code: 7 skills, 7 agents and 11 scripts
          that score each part of your application from public data, with no API keys. It
          needs Python 3.10+ and the GitHub CLI. Not on Claude Code? Load each
          <code>SKILL.md</code> into any AI assistant as instructions.
        </p>
        <div class="hero-cta">
          <a class="b b-primary" href={KIT} target="_blank" rel="noopener">The kit on GitHub ↗</a>
          <a class="b b-plain kit-slides" href={slidesHref}>Open the slides →</a>
        </div>
      </div>
      <div class="term term-nowrap">
        <div class="term-bar"><i></i><i></i><i></i><span>claude</span></div>
        <div class="term-body">
          <span class="l"><span class="u">›</span> /plugin marketplace add Vets-Who-Code/ai-era-job-kit</span>
          <span class="l"><span class="u">›</span> /plugin install ai-era-job-kit@ai-era-job-kit</span>
          <span class="l"><span class="g">✔</span> installed</span>
          <span class="l"></span>
          <span class="l"><span class="u">›</span> /job-hunt</span>
          <span class="l"><span class="d">1 resume    </span> lane score · Screen Grade</span>
          <span class="l"><span class="d">2 linkedin  </span> same target, same record</span>
          <span class="l"><span class="d">3 github    </span> profile · pinned repos</span>
          <span class="l"><span class="d">4 portfolio </span> checklist · sync check</span>
          <span class="l"><span class="d">5–7         </span> composite · plan · rebuild</span>
          <span class="l"><span class="v">next →</span> score your resume</span>
          <span class="l"><span class="u">›</span> <span class="cursor">▋</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HOW TO JOIN ===================== -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl">How to join</span>
        <h2 class="display-2">Three steps, all of them short</h2>
      </div>
      <ol class="rules">
        <li class="k k-flat">
          <span class="rule-n">01</span>
          <h3>Message me</h3>
          <p>
            On <a href={SITE.instructor.linkedin} target="_blank" rel="noopener">LinkedIn</a> or
            at <a href={`mailto:${SITE.instructor.email}?subject=${encodeURIComponent(W.title + ' webinar')}`}>{SITE.instructor.email}</a>.
            One line is enough.
          </p>
        </li>
        <li class="k k-flat">
          <span class="rule-n">02</span>
          <h3>Join the Telegram group</h3>
          <p>I add you to the webinar group. The live link and reminders go out there.</p>
        </li>
        <li class="k k-flat">
          <span class="rule-n">03</span>
          <h3>Show up {dayShort}</h3>
          <p>{W.start}–{W.end} {W.tz}, live. Bring your resume and the job you actually want.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ===================== HOST ===================== -->
  <section class="s-paper2">
    <div class="wrap inst">
      <div class="inst-photo">
        <img src="/headshot.jpg" alt={`${SITE.instructor.name}, host`} width="300" height="300" loading="lazy" />
        <span class="inst-badge"><Mark size={22} variant="bare" /> host</span>
      </div>
      <div class="inst-copy">
        <span class="lbl">Who is hosting</span>
        <h2 class="display-2">{SITE.instructor.name}</h2>
        <p class="inst-role">{SITE.instructor.role}</p>
        <p>
          I lead an engineering team and mentor developers through the 12-week AI Engineering
          program. I also run a Telegram channel of job alerts. This session is the job search
          system I hand to every developer I mentor.
        </p>
        <div class="hero-cta">
          <a class="b b-plain" href="/resume">Résumé</a>
          <a class="b b-plain" href={SITE.instructor.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section id="faq">
    <div class="wrap two-col">
      <div class="col-head">
        <span class="lbl">Questions</span>
        <h2 class="display-2">Before you ask</h2>
      </div>
      <div class="col-body faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}<i aria-hidden="true"></i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PAST ===================== -->
  <section class="s-paper2">
    <div class="wrap">
      <div class="sec-head">
        <span class="lbl">Past webinars</span>
        <h2 class="display-2">Missed the last one?</h2>
        <p class="lede">Every webinar page and deck stays online.</p>
      </div>
      <article class="k k-flat past">
        <span class="rule-n">Thu 29 Oct 2026 · 4 hours</span>
        <h3>AI Agent Workflows</h3>
        <p>Agent fundamentals, non-agent workflows, single-agent and multi-agent patterns, and how to evaluate them. 5 modules, 21 topics.</p>
        <div class="hero-cta">
          <a class="b b-plain" href="/webinar/ai-agent-workflows/">Webinar page →</a>
          <a class="b b-plain" href="/webinar/ai-agent-workflows/slides">Slides →</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ===================== FINAL ===================== -->
  <section class="s-ink final">
    <div class="wrap ctr">
      <span class="lbl lbl-gold">{day} · {W.start}–{W.end} {W.tz}</span>
      <h2 class="display-2">Score it. Build the record.<br />Run it every week.</h2>
      <p>Send me one line and I will add you to the group.</p>
      <a class="b b-primary" href={W.join.href} target="_blank" rel="noopener">{W.join.label} →</a>
      <p class="fine">
        Want to keep going after the webinar? <a href="/job-search-group/">Join the 12-week Job Search Group</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Same furniture as the AI Agent Workflows page, so the webinars read as one site. */
  .hero { position: relative; padding: 4.5rem 0 4rem; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; align-items: center; }

  h1.display-1 { margin: 1.4rem 0 0; font-size: clamp(2.4rem, 5.2vw, 4.1rem); text-wrap: pretty; }
  .mark-gold {
    display: inline;
    background: linear-gradient(transparent 62%, var(--gold) 62%, var(--gold) 94%, transparent 94%);
    padding: 0 0.08em;
  }
  .hero-sub { font-size: 1.16rem; max-width: 54ch; margin: 1.5rem 0 0; color: var(--ink-soft); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }

  .stats { display: flex; flex-wrap: wrap; gap: 2.2rem; margin: 2.8rem 0 0; padding-top: 1.6rem; border-top: 1px solid var(--rule); }
  .stats dt { font-family: var(--display); font-weight: 700; font-size: 2.4rem; line-height: 1; color: var(--violet-deep); }
  .stats dd { margin: 0.35rem 0 0; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }

  .hero-term { transform: rotate(1.1deg); }
  .term .cursor { color: var(--gold); animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .term-body { overflow-x: auto; }
  .term-nowrap .term-body .l { white-space: pre; }
  .term-note { margin: 1rem 0 0; text-align: center; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }

  .band-track b { font-weight: 500; color: #e9e4ff; }
  .band-track i { font-style: normal; color: var(--gold); }

  .sec-head { max-width: 62ch; margin-bottom: 2.8rem; }
  .sec-head h2 { margin: 1rem 0 0; }
  .sec-head .lede { margin-top: 1rem; }
  .lede { font-size: 1.1rem; color: var(--ink-soft); max-width: 60ch; }

  /* rules + join steps */
  .rules { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.15rem; }
  .rule-n { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.16em; color: var(--gold-deep); }
  .rules h3, .past h3 { font-size: 1.2rem; margin: 0.6rem 0 0.45rem; }
  .rules p, .past p { font-size: 0.95rem; margin: 0; }
  .past { max-width: 720px; }

  /* pipeline */
  .pipe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .pipe-grid h2 { margin: 1rem 0 0; }
  .pipe-grid .lede { margin-top: 1rem; }

  /* agenda */
  .mods { display: grid; gap: 1.15rem; }
  .mod {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr 0.8fr;
    gap: 2rem;
    align-items: start;
    padding: 1.6rem 1.7rem;
    background: #fff;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--violet);
    border-radius: var(--r);
    box-shadow: var(--lift);
  }
  .mod-hd { display: flex; gap: 1rem; align-items: baseline; }
  .mod-n { font-family: var(--mono); font-weight: 600; font-size: 1.15rem; color: var(--violet-deep); }
  .mod h3 { font-size: 1.35rem; margin: 0; }
  .mod-who { margin: 0.45rem 0 0; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; color: var(--gold-deep); }
  .topics { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .topics li { display: grid; gap: 0.15rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--rule); }
  .topics li:last-child { border-bottom: 0; padding-bottom: 0; }
  .tp-t { font-weight: 600; color: var(--ink); }
  .tp-l { font-size: 0.9rem; color: var(--ink-soft); }
  .mod-out { background: var(--paper-2); border-radius: var(--r); padding: 1rem 1.1rem; }
  .mod-out p { font-size: 0.92rem; margin: 0.3rem 0 0.9rem; }
  .out-lbl { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--violet-deep); }
  .chips { list-style: none; margin: 0.45rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips code { font-family: var(--mono); font-size: 0.74rem; padding: 0.15rem 0.5rem; border: 1px solid var(--rule-strong); border-radius: 999px; background: #fff; }

  /* toolkit */
  .kit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .kit-grid h2 { margin: 1rem 0 0.8rem; }
  .kit-grid p code { font-family: var(--mono); font-size: 0.88em; }
  .kit-grid p a { color: var(--gold); }
  .kit-slides { color: #fff !important; border-color: rgba(233, 228, 255, 0.3) !important; background: transparent !important; }

  /* host */
  .inst { display: grid; grid-template-columns: 300px 1fr; gap: 3rem; align-items: start; }
  .inst-photo { position: relative; }
  .inst-photo img { display: block; width: 100%; border: 1px solid var(--rule); border-radius: var(--r-lg); box-shadow: var(--lift-2); object-fit: cover; aspect-ratio: 1; }
  .inst-badge {
    position: absolute; left: -12px; bottom: -14px;
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--gold); border: 1px solid var(--gold-deep); border-radius: 999px;
    padding: 0.4rem 0.95rem; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    box-shadow: var(--lift-2);
  }
  .inst-copy h2 { margin: 0.9rem 0 0.4rem; }
  .inst-role { font-family: var(--mono); font-size: 0.82rem; color: var(--violet-deep); margin-bottom: 1.2rem; }

  /* faq */
  .two-col { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 3.5rem; }
  .col-head h2 { margin-top: 1rem; position: sticky; top: 100px; }
  .faqs { display: grid; }
  .faq { border-bottom: 1px solid var(--rule); }
  .faq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.15rem 0; cursor: pointer; font-family: var(--display); font-weight: 700; font-size: 1.08rem; list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary i { flex: none; width: 22px; height: 22px; border: 1.5px solid var(--rule-strong); border-radius: 50%; position: relative; }
  .faq summary i::before, .faq summary i::after {
    content: ""; position: absolute; inset: 50% 4px auto 4px; height: 2px; background: var(--ink); transform: translateY(-50%);
  }
  .faq summary i::after { transform: translateY(-50%) rotate(90deg); transition: transform 0.18s ease; }
  .faq[open] summary i::after { transform: translateY(-50%) rotate(0deg); }
  .faq p { padding: 0 0 1.3rem; margin: 0; max-width: 68ch; }

  /* final */
  .final { text-align: center; }
  .final h2 { margin-top: 1.2rem; }
