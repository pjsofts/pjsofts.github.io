switch (kind) {
  case 'refund':
    return refundFlow(input)
  case 'question': {
    const outline = await llm(OUTLINE, input) // chaining
    if (!isValid(outline)) throw new Error('gate')
    const [a, b] = await Promise.all([        // parallel
      llm(DRAFT, outline), llm(CHECK, outline),
    ])
    return merge(a, b)
  }
}`,
