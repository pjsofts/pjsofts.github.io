    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.instructor.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <meta name="theme-color" content="#17132e" />
  </head>
  <body>
    <div class="viewport">
      <div class="stage" id="stage">
        {slides.map((s, i) => (
          <article
            class={`slide ${s.t === 'section' || s.t === 'statement' || s.t === 'end' ? 'is-ink' : ''} slide-${s.t}`}
            data-i={i}
            aria-label={`Slide ${i + 1} of ${N}`}
          >
            {s.t === 'title' && (
              <>
                <span class="blob blob-violet" aria-hidden="true"></span>
                <span class="blob blob-gold" aria-hidden="true"></span>
                <div class="title-body">
                  <span class="lbl lbl-gold">Free webinar · {day}</span>
                  <h1>
                    AI agent workflows,<br /><span class="mark-gold">pattern by pattern.</span>
                  </h1>
                  <p class="title-sub">{WEBINAR.tagline}</p>
                  <div class="title-by">
                    <Mark size={52} />
                    <div>
                      <strong>{SITE.instructor.name}</strong>
                      <span>pjsofts.github.io · linkedin.com/in/pouria-jahandideh</span>
                    </div>
                  </div>
                </div>
              </>
            )}

            {s.t === 'section' && (
              <div class="sec-body">
                <span class="sec-n">{s.n}</span>
                <h2>{s.title}</h2>
                <p>{s.sub}</p>
              </div>
            )}

            {s.t === 'statement' && (
              <div class="stmt-body">
                <p class="stmt">{s.text}</p>
                {s.sub && <p class="stmt-sub">{s.sub}</p>}
              </div>
            )}

            {s.t === 'agenda' && (
              <>
                <header class="hd"><span class="lbl">Today</span><h2>Five modules, one climb</h2></header>
                <ol class="agenda">
                  {MODULES.map((m) => (
                    <li>
                      <span class="ag-n">{m.n}</span>
                      <span class="ag-t">{m.title}</span>
                      <span class="ag-l">{m.topics.map((t) => t.title).join(' · ')}</span>
                    </li>
                  ))}
                </ol>
              </>
            )}

            {s.t === 'dial' && (
              <>
                <header class="hd"><span class="lbl">The control dial</span><h2>Three rungs of autonomy</h2></header>
                <div class="dial">
                  {dial.map(([t, b, kind], j) => (
                    <div class="dial-col">
                      <span class="dial-n">0{j + 1}</span>
                      <h3>{t}</h3>
                      <p>{b}</p>
                      <Topology kind={kind} title={`${t} diagram`} />
                    </div>
                  ))}
                </div>
                <p class="foot-note">More autonomy buys flexibility, and costs calls, latency and predictability.</p>
              </>
            )}

            {s.t === 'points' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <ol class={`pts ${s.points.length > 4 ? 'is-dense' : ''}`}>
                  {s.points.map((p, j) => (
                    <li>
                      <span class="pt-n">{String(j + 1).padStart(2, '0')}</span>
                      {Array.isArray(p) ? (
                        <span><strong>{p[0]}</strong> <span class="pt-rest">{p[1]}</span></span>
                      ) : (
                        <span>{p}</span>
                      )}
                    </li>
                  ))}
                </ol>
                {s.read && <a class="read" href={s.read.href}>Read more → {s.read.label}</a>}
              </>
            )}

            {s.t === 'compare' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <div class="cmp">
                  {s.cols.map((c) => (
                    <div class={`cmp-col tone-${c.tone}`}>
                      <h3>{c.h}</h3>
                      <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
                    </div>
                  ))}
                </div>
                {s.foot && <p class="foot-note">{s.foot}</p>}
              </>
            )}

            {s.t === 'pattern' && (
              <>
                <header class="hd">
                  <span class="lbl">{s.lbl}</span>
                  <h2>{s.title}{s.cite && <span class="cite">{s.cite}</span>}</h2>
                </header>
                <div class="pat">
                  <p class="pat-idea">{s.idea}</p>
                  <div class="pat-topo"><Topology kind={s.diagram} title={`${s.title} diagram`} /></div>
                </div>
                <div class="pat-uw">
                  <div class="uw uw-use"><span>Use when</span><p>{s.use}</p></div>
                  <div class="uw uw-watch"><span>Watch for</span><p>{s.watch}</p></div>
                </div>
              </>
            )}

            {s.t === 'code' && (
              <div class="code-grid">
                <div class="code-copy">
                  <span class="lbl">{s.lbl}</span>
                  <h2>{s.title}</h2>
                  <p>{s.caption}</p>
                  {s.read && <a class="read" href={s.read.href}>Read more → {s.read.label}</a>}
                </div>
                <div class="term">
                  <div class="term-bar"><i></i><i></i><i></i><span>{s.file}</span></div>
                  <div class="term-body code" set:html={hl(s.code)} />
                </div>
              </div>
            )}

            {s.t === 'table' && (
              <>
                <header class="hd"><span class="lbl">{s.lbl}</span><h2>{s.title}</h2></header>
                <table class="tbl">
                  <thead><tr>{s.head.map((h) => <th>{h}</th>)}</tr></thead>
                  <tbody>{s.rows.map((r) => <tr>{r.map((c, j) => (j === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
                </table>
              </>
            )}

            {s.t === 'ladder' && (
              <>
                <header class="hd"><span class="lbl">So what do I use?</span><h2>Climb only when the rung below fails</h2></header>
                <ol class="ladder">
                  {ladder.map(([t, b], j) => (
                    <li style={`--step:${j}`}>
                      <span class="ld-n">{String(j + 1).padStart(2, '0')}</span>
                      <strong>{t}</strong>
                      <span>{b}</span>
                    </li>
                  ))}
                </ol>
                <p class="foot-note">“Fails” means fails your evals, not that it feels too simple.</p>
              </>
            )}

            {s.t === 'reading' && (
              <>
                <header class="hd"><span class="lbl">Further reading</span><h2>Where these ideas come from</h2></header>
                <div class="reading">
                  <ul class="refs">
                    {refs.map(([t, by, href]) => (
                      <li><a href={href} target="_blank" rel="noopener">{t}</a><span>{by}</span></li>
                    ))}
                  </ul>
                  <div class="mine">
                    <h3>On this site</h3>
                    <ul>{mine.map(([t, href]) => <li><a href={href}>{t}</a></li>)}</ul>
                  </div>
                </div>
              </>
            )}

            {s.t === 'end' && (
              <div class="end-body">
                <Mark size={72} />
                <h2>Thank you. Questions?</h2>
                <p>
                  Build all of this yourself, from the agent loop up, in the 12-week
                  AI Engineering course.
                </p>
                <ul class="end-links">
                  <li><span>site</span> pjsofts.github.io</li>
                  <li><span>linkedin</span> linkedin.com/in/pouria-jahandideh</li>
                  <li><span>email</span> {SITE.instructor.email}</li>
                  <li><span>telegram</span> {SITE.telegram.handle}</li>
                </ul>
              </div>
            )}

            {s.t !== 'title' && (
              <footer class="sfoot">
                <span class="sf-brand"><Mark size={20} variant="bare" /> {SITE.instructor.name} · {WEBINAR.title}</span>
                <span class="sf-n">{String(i + 1).padStart(2, '0')} / {N}</span>
              </footer>
            )}
          </article>
        ))}
      </div>
    </div>

    <nav class="controls" aria-label="Slide controls">
      <a class="ctl-back" href={landing}>← Webinar page</a>
      <div class="ctl-mid">
        <button type="button" data-go="prev" aria-label="Previous slide">←</button>
        <span id="counter" aria-live="polite">1 / {N}</span>
        <button type="button" data-go="next" aria-label="Next slide">→</button>
      </div>
      <div class="ctl-right">
        <button type="button" data-go="full" aria-label="Full screen">⛶ <span>F</span></button>
        <button type="button" data-go="print" aria-label="Print or save as PDF">PDF</button>
      </div>
    </nav>
    <div class="progress" aria-hidden="true"><i id="bar"></i></div>

    <script>
      const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
      const counter = document.getElementById('counter')!;
      const bar = document.getElementById('bar')!;
      const N = slides.length;
      let cur = 0;

      // Slides are 1-indexed in the URL, so #12 is what the counter says.
      const fromHash = () => {
        const n = parseInt(location.hash.slice(1), 10);
        return Number.isFinite(n) ? Math.min(Math.max(n - 1, 0), N - 1) : 0;
      };

      function show(i: number) {
        cur = Math.min(Math.max(i, 0), N - 1);
        slides.forEach((s, j) => s.classList.toggle('on', j === cur));
        counter.textContent = `${cur + 1} / ${N}`;
        bar.style.width = `${((cur + 1) / N) * 100}%`;
        history.replaceState(null, '', `#${cur + 1}`);
      }

      function fit() {
        const s = Math.min(window.innerWidth / 1280, (window.innerHeight - 52) / 720);
        document.documentElement.style.setProperty('--s', String(s));
      }

      function full() {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.();
      }

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const k = e.key;
        if (['ArrowRight', 'PageDown', ' ', 'l'].includes(k)) show(cur + 1);
        else if (['ArrowLeft', 'PageUp', 'h'].includes(k)) show(cur - 1);
        else if (k === 'Home') show(0);
        else if (k === 'End') show(N - 1);
        else if (k === 'f' || k === 'F') full();
        else return;
        e.preventDefault();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
        b.addEventListener('click', () => {
          const go = b.dataset.go;
          if (go === 'next') show(cur + 1);
          else if (go === 'prev') show(cur - 1);
          else if (go === 'full') full();
          else if (go === 'print') window.print();
        }),
      );

      let x0: number | null = null;
      document.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      document.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
        x0 = null;
      });

      window.addEventListener('resize', fit);
      window.addEventListener('hashchange', () => show(fromHash()));
      fit();
      show(fromHash());
    </script>
  </body>
</html>

<style>
  /* ---------------- the frame ---------------- */
  :global(html), :global(body) { height: 100%; }
  :global(body) {
    margin: 0;
    overflow: hidden;
    background: #0b0918 !important;
  }
  .viewport {
    position: fixed;
    inset: 0 0 52px 0;
    display: grid;
    place-items: center;
  }
  .stage {
    width: 1280px;
    height: 720px;
    position: relative;
    transform: scale(var(--s, 1));
    flex: none;
  }

  /* ---------------- a slide ---------------- */
  .slide {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    padding: 64px 84px 76px;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
    --topo-ground: var(--paper);
  }
  .slide.on { display: flex; }
  .slide.is-ink { background: var(--ink); color: #d9d3f5; }

  .slide :global(.lbl) { font-size: 14px; }
  .hd { margin-bottom: 34px; }
  .hd h2, .code-copy h2 {
    margin: 14px 0 0;
    font-size: 54px;
    line-height: 1.02;
  }
  .cite {
    margin-left: 18px;
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    vertical-align: middle;
  }

  .sfoot {
    position: absolute;
    left: 84px;
    right: 84px;
    bottom: 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .sf-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--violet-deep); }
  .sf-brand :global(svg) { color: var(--violet); }
  .is-ink .sfoot { border-top-color: rgba(233, 228, 255, 0.14); color: #8e87b8; }
  .is-ink .sf-brand { color: #c3bce8; }
  .is-ink .sf-brand :global(svg) { color: var(--gold); }

  .foot-note {
    margin: auto 0 0;
    padding: 16px 22px;
    font-size: 21px;
    line-height: 1.45;
    color: var(--ink);
    background: var(--gold-wash);
    border-left: 4px solid var(--gold);
    border-radius: 8px;
  }
  .read {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 16px;
    color: var(--violet-deep) !important;
  }

  /* ---------------- title ---------------- */
  .slide-title { justify-content: center; }
  .blob { position: absolute; border-radius: 50%; }
  .blob-violet { width: 720px; height: 720px; background: var(--violet-wash); right: -220px; top: -300px; }
  .blob-gold { width: 360px; height: 360px; background: var(--gold-wash); left: -160px; bottom: -180px; }
  .title-body { position: relative; z-index: 1; }
  .slide-title h1 { margin: 28px 0 0; font-size: 104px; line-height: 0.98; }
  .mark-gold { background: linear-gradient(transparent 62%, var(--gold) 62%, var(--gold) 94%, transparent 94%); padding: 0 0.06em; }
  .title-sub { margin: 30px 0 0; font-size: 28px; max-width: 34ch; color: var(--ink-soft); }
  .title-by { display: flex; align-items: center; gap: 18px; margin-top: 56px; }
  .title-by strong { display: block; font-family: var(--display); font-size: 26px; }
  .title-by span { font-family: var(--mono); font-size: 15px; color: var(--ink-soft); }

  /* ---------------- section / statement / end ---------------- */
  .sec-body, .stmt-body, .end-body { margin: auto 0; }
  .sec-n { font-family: var(--mono); font-size: 30px; font-weight: 600; color: var(--gold); letter-spacing: 0.1em; }
  .sec-body h2 { margin: 18px 0 0; font-size: 104px; line-height: 0.98; color: #fff; }
  .sec-body p { margin: 26px 0 0; font-size: 30px; color: #a49dd0; }
  .sec-body::before {
    content: "";
    display: block;
    width: 96px;
    height: 6px;
    background: var(--gold);
    margin-bottom: 40px;
  }

  .stmt { margin: 0; font-family: var(--display); font-weight: 700; font-size: 70px; line-height: 1.06; letter-spacing: -0.03em; color: #fff; max-width: 20ch; text-wrap: balance; }
  .stmt-sub { margin: 34px 0 0; font-size: 28px; color: #a49dd0; max-width: 50ch; padding-left: 22px; border-left: 4px solid var(--gold); }

  .end-body { text-align: left; }
  .end-body h2 { margin: 30px 0 0; font-size: 88px; color: #fff; }
  .end-body p { margin: 20px 0 0; font-size: 26px; color: #a49dd0; max-width: 44ch; }
  .end-links { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 40px; font-family: var(--mono); font-size: 20px; color: #fff; }
  .end-links span { display: inline-block; width: 110px; color: var(--gold); text-transform: uppercase; font-size: 14px; letter-spacing: 0.14em; }

  /* ---------------- agenda ---------------- */
  .agenda { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .agenda li {
    display: grid;
    grid-template-columns: 64px 330px 1fr;
    align-items: baseline;
    gap: 20px;
    padding: 16px 22px;
    background: #fdfbf6;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--violet);
    border-radius: 10px;
  }
  .ag-n { font-family: var(--mono); font-size: 22px; font-weight: 600; color: var(--violet-deep); }
  .ag-t { font-family: var(--display); font-weight: 700; font-size: 28px; letter-spacing: -0.02em; }
  .ag-l { font-size: 17px; color: var(--ink-soft); line-height: 1.4; }

  /* ---------------- dial ---------------- */
  .dial { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-bottom: 26px; }
  .dial-col { padding: 22px 22px 16px; background: #fdfbf6; border: 1px solid var(--rule); border-radius: 12px; --topo-ground: #fdfbf6; }
  .dial-n { font-family: var(--mono); font-size: 15px; letter-spacing: 0.16em; color: var(--gold-deep); }
  .dial-col h3 { margin: 8px 0 6px; font-size: 32px; }
  .dial-col p { margin: 0 0 14px; font-size: 19px; line-height: 1.4; min-height: 54px; }

  /* ---------------- points ---------------- */
  .pts { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .pts li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; font-size: 26px; line-height: 1.38; color: var(--ink-soft); }
  .pts.is-dense { gap: 12px; }
  .pts.is-dense li { font-size: 23px; }
  .pt-n { font-family: var(--mono); font-weight: 600; font-size: 20px; color: var(--violet); padding-top: 5px; }
  .pts strong { display: block; color: var(--ink); font-family: var(--display); font-weight: 700; }
  .pt-rest { font-size: 0.86em; }

  /* ---------------- compare ---------------- */
  .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; margin-bottom: 26px; }
  .cmp-col { padding: 24px 28px; border-radius: 12px; border: 1px solid var(--rule); }
  .cmp-col h3 { margin: 0 0 14px; font-size: 28px; }
  .cmp-col ul { margin: 0; padding: 0 0 0 22px; display: grid; gap: 10px; }
  .cmp-col li { font-size: 21px; line-height: 1.38; color: var(--ink-soft); }
  .cmp-col li::marker { color: var(--violet); }
  .cmp-col.tone-violet { background: var(--violet-wash); border-color: rgba(109, 75, 208, 0.28); }
  .cmp-col.tone-gold { background: var(--gold-wash); border-color: rgba(201, 163, 56, 0.4); }
  .cmp-col.tone-gold li::marker { color: var(--gold-deep); }
  .cmp-col.tone-ink { background: var(--ink); border-color: var(--ink); }
  .cmp-col.tone-ink h3 { color: #fff; }
  .cmp-col.tone-ink li { color: #c3bce8; }
  .cmp-col.tone-ink li::marker { color: var(--gold); }

  /* ---------------- pattern ---------------- */
  .slide-pattern .hd { margin-bottom: 22px; }
  .pat { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: 40px; align-items: center; flex: 1; min-height: 0; }
  .pat-idea { margin: 0; font-size: 24px; line-height: 1.45; color: var(--ink); }
  .pat-topo { min-width: 0; }
  .pat-uw { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 18px; }
  .uw { padding: 14px 20px; border-radius: 10px; border: 1px solid var(--rule); }
  .uw span { font-family: var(--mono); font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  .uw p { margin: 6px 0 0; font-size: 18.5px; line-height: 1.4; color: var(--ink); }
  .uw-use { background: var(--violet-wash); border-color: rgba(109, 75, 208, 0.28); }
  .uw-use span { color: var(--violet-deep); }
  .uw-watch { background: var(--gold-wash); border-color: rgba(201, 163, 56, 0.4); }
  .uw-watch span { color: var(--gold-deep); }

  /* ---------------- code ---------------- */
  .code-grid { display: grid; grid-template-columns: 0.68fr 1.32fr; gap: 44px; align-items: center; flex: 1; min-height: 0; }
  .code-copy { display: flex; flex-direction: column; height: 100%; justify-content: center; }
  .code-copy p { margin: 22px 0 28px; font-size: 22px; line-height: 1.5; }
  .code-copy .read { margin-top: 0; }
  .slide .term { font-size: 17px; line-height: 1.6; }
  .slide .term-bar span { font-size: 12px; }
  .code { padding: 20px 24px 24px; }
  .code :global(.l) { display: block; white-space: pre; min-height: 1.6em; }

  /* ---------------- table ---------------- */
  .tbl { display: table; width: 100%; margin: 0; font-size: 21px; border-collapse: separate; border-spacing: 0; background: #fdfbf6; border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; }
  .tbl thead th { font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; padding: 14px 20px; background: var(--ink); color: #fff; border: 0; }
  .tbl tbody th { font-family: var(--display); font-size: 22px; color: var(--ink); background: transparent; text-transform: none; letter-spacing: -0.01em; padding: 13px 20px; white-space: nowrap; border-bottom: 1px solid var(--rule); }
  .tbl td { padding: 13px 20px; color: var(--ink-soft); }
  .tbl tbody tr:last-child > * { border-bottom: 0; }

  /* ---------------- ladder ---------------- */
  .ladder { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 12px; }
  .ladder li {
    display: grid;
    grid-template-columns: 56px 240px 1fr;
    gap: 18px;
    align-items: baseline;
    padding: 16px 22px;
    margin-left: calc(var(--step) * 56px);
    background: #fdfbf6;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--violet);
    border-radius: 10px;
  }
  .ladder li:last-child { border-left-color: var(--gold-deep); }
