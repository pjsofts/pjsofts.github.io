// Tiny highlighter for the code slides: comments dim, strings amber. Escaping
// first so a `<` in a sample can never become markup.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
function hl(code: string) {
  return code
    .split('\n')
    .map((line) => {
      const m = line.match(/^(.*?)((?:\/\/|#(?!!)).*)$/);
      const [body, comment] = m && !/["'][^"']*$/.test(m[1]) ? [m[1], m[2]] : [line, ''];
      const b = esc(body).replace(/("[^"]*"|'[^']*')/g, '<span class="u">$1</span>');
      return `<span class="l">${b}${comment ? `<span class="d">${esc(comment)}</span>` : ''}</span>`;
    })
    .join('');
}

