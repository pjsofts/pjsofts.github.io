---
// The brand mark: the PJ emblem cropped from logo.png, without the wordmark,
// so it stays readable at the 20–40px it is actually drawn at. The full lockup
// (public/logo.png) is for places that show it large.
interface Props {
  size?: number;
  /** Kept for existing call sites; both variants draw the emblem tile. */
  variant?: 'solid' | 'bare';
  class?: string;
}
const { size = 40, class: cls = '' } = Astro.props;
---

<img
  src="/logo-mark.png"
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  class={`mark ${cls}`}
  style={`border-radius:${Math.round(size * 0.24)}px`}
/>

<style>
  .mark { display: inline-block; flex: none; object-fit: cover; vertical-align: middle; }
</style>
