---
// A pattern diagram: boxes and arrows from src/data/topologies.ts.
//
// The geometry is done here so the data stays readable: every arrow is clipped
// to the edge of the boxes it joins, so a node can be moved by changing one
// x/y pair and nothing else needs redrawing.
import { TOPOLOGIES, type TNode } from '../data/topologies';

interface Props {
  kind: string;
  /** Accessible name. */
  title?: string;
  class?: string;
}
const { kind, title, class: cls = '' } = Astro.props;
const topo = TOPOLOGIES[kind];
if (!topo) throw new Error(`Unknown topology: ${kind}`);

// Several diagrams share a page, and marker ids are document-global.
const uid = `t-${kind}-${Math.random().toString(36).slice(2, 8)}`;

const W = 680;
const H = 260;
const size = (n: TNode) => ({ w: n.w ?? 110, h: n.sub ? 54 : 40 });
const byId = Object.fromEntries(topo.nodes.map((n) => [n.id, n]));

/** Where a ray from the centre of `n` towards (tx, ty) leaves its box. */
function clip(n: TNode, tx: number, ty: number, gap: number) {
  const { w, h } = size(n);
  const dx = tx - n.x;
  const dy = ty - n.y;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const t = Math.min(ux ? w / 2 / Math.abs(ux) : Infinity, uy ? h / 2 / Math.abs(uy) : Infinity) + gap;
  return { x: n.x + ux * t, y: n.y + uy * t };
}

const edges = topo.edges.map((e) => {
  const a = byId[e.from];
  const b = byId[e.to];
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const len = Math.hypot(b.x - a.x, b.y - a.y) || 1;
  // Left-hand normal of the direction of travel.
  const nx = -(b.y - a.y) / len;
  const ny = (b.x - a.x) / len;
  const bend = e.curve ?? 0;
  // A quadratic peaks at half its control offset, so double it to bend by `curve`.
  const cx = mx + nx * bend * 2;
  const cy = my + ny * bend * 2;
  const s = clip(a, bend ? cx : b.x, bend ? cy : b.y, 3);
  const t = clip(b, bend ? cx : a.x, bend ? cy : a.y, e.plain ? 3 : 6);
  const d = bend
    ? `M${s.x.toFixed(1)} ${s.y.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${t.x.toFixed(1)} ${t.y.toFixed(1)}`
    : `M${s.x.toFixed(1)} ${s.y.toFixed(1)} L${t.x.toFixed(1)} ${t.y.toFixed(1)}`;
  // Labels sit at the curve's midpoint, nudged off the line.
  const lx = bend ? 0.25 * s.x + 0.5 * cx + 0.25 * t.x : mx;
  const ly = bend ? 0.25 * s.y + 0.5 * cy + 0.25 * t.y + (bend < 0 ? 16 : -8) : my - 9;
  return { ...e, d, lx, ly };
});
---

<svg
  class={`topo ${cls}`}
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={title ?? `${kind} pattern diagram`}
>
  <defs>
    <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="topo-head" />
    </marker>
  </defs>

  {edges.map((e) => (
    <path
      d={e.d}
      class={`topo-edge ${e.dashed ? 'is-dashed' : ''}`}
      marker-end={e.plain ? undefined : `url(#${uid}-a)`}
    />
  ))}

  {topo.nodes.map((n) => {
    const { w, h } = size(n);
    return (
      <g class={`topo-node tone-${n.tone ?? 'paper'}`}>
        <rect x={n.x - w / 2} y={n.y - h / 2} width={w} height={h} rx="9" />
        <text x={n.x} y={n.sub ? n.y - 4 : n.y + 5} class="topo-label">{n.label}</text>
        {n.sub && <text x={n.x} y={n.y + 15} class="topo-sub">{n.sub}</text>}
      </g>
    );
  })}

  {edges.filter((e) => e.label).map((e) => (
    <text x={e.lx} y={e.ly} class="topo-elabel">{e.label}</text>
  ))}
</svg>

<style>
  .topo { display: block; width: 100%; height: auto; overflow: visible; }
  .topo-edge {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .topo-edge.is-dashed { stroke-dasharray: 5 5; }
  .topo-head { fill: var(--ink-soft); }

  .topo-node rect { stroke-width: 1.4; }
  .topo-label {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
  }
  .topo-sub {
    font-family: var(--mono);
    font-size: 11.5px;
    text-anchor: middle;
    letter-spacing: 0.04em;
  }
  .topo-elabel {
    font-family: var(--mono);
    font-size: 12px;
    text-anchor: middle;
    fill: var(--violet-deep);
    /* A halo in the ground colour, so a label crossing a line stays legible. */
    paint-order: stroke;
    stroke: var(--topo-ground, var(--paper));
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .tone-paper rect { fill: #fdfbf6; stroke: var(--rule-strong); }
  .tone-paper .topo-label { fill: var(--ink); }
  .tone-paper .topo-sub { fill: var(--ink-soft); }

  .tone-ink rect { fill: var(--ink); stroke: var(--ink); }
  .tone-ink .topo-label { fill: #fff; }
  .tone-ink .topo-sub { fill: #a49dd0; }

  .tone-gold rect { fill: var(--gold); stroke: var(--gold-deep); }
  .tone-gold .topo-label { fill: var(--ink); }
  .tone-gold .topo-sub { fill: #5a4a17; }

  .tone-violet rect { fill: var(--violet-wash); stroke: var(--violet); }
  .tone-violet .topo-label { fill: var(--violet-deep); }
  .tone-violet .topo-sub { fill: var(--violet-deep); }
</style>
