---
import { SITE } from '../data/site';

interface Props {
  lang?: 'en' | 'fa';
}
const { lang = 'en' } = Astro.props;
const fa = lang === 'fa';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div>
        <div class="fbrand">
          <img src="/logo.jpg" alt="" width="38" height="38" />
          <div>
            <div class="fb-name">AI ENGINEERING</div>
            <div class="fb-sub">{fa ? 'ساخت کلون Claude Code از صفر' : 'Build a Claude Code clone from scratch'}</div>
          </div>
        </div>
        <p class="fdesc">
          {fa
            ? 'یک منتورشیپ عملی ۱۲ هفته‌ای برای مهندسانی که هوش مصنوعی را جدی گرفته‌اند. کد واقعی، بدون فریمورک، و یک پروژهٔ نمونه‌کار در پایان.'
            : 'A 12-week hands-on mentorship for engineers who are serious about AI. Real code, no frameworks, a portfolio project at the end.'}
        </p>
      </div>

      <div>
        <h4>{fa ? 'دوره' : 'Course'}</h4>
        <a href={fa ? '/fa/curriculum' : '/curriculum'}>{fa ? 'سرفصل کامل دوره' : 'Full curriculum'}</a>
        <a href={fa ? '/fa/curriculum/week-1-your-first-agent' : '/curriculum/week-1-your-first-agent'}>
          {fa ? 'هفتهٔ ۱ — اولین ایجنت شما' : 'Week 1 — Your first agent'}
        </a>
        <a href={fa ? '/fa/#outcomes' : '/#outcomes'}>{fa ? 'چه چیزی می‌سازید' : 'What you build'}</a>
        <a href={fa ? '/fa/#faq' : '/#faq'}>{fa ? 'پرسش‌های پرتکرار' : 'FAQ'}</a>
      </div>

      <div>
        <h4>{fa ? 'نوشته‌ها' : 'Writing'}</h4>
        <a href="/blog">{fa ? 'همهٔ مقاله‌ها (انگلیسی)' : 'All articles'}</a>
        <a href="/blog/chat-completions-vs-responses-api">Completions vs Responses API</a>
        <a href="/blog/designing-tools-for-ai-agents">{fa ? 'طراحی ابزار برای ایجنت‌ها' : 'Designing tools for agents'}</a>
        <a href="/rss.xml">{fa ? 'خوراک RSS' : 'RSS feed'}</a>
      </div>

      <div>
        <h4>{fa ? 'مدرس' : 'Instructor'}</h4>
        <a href={fa ? '/fa/resume' : '/resume'}>{fa ? 'رزومه و سوابق' : 'Résumé & experience'}</a>
        <a href={SITE.instructor.linkedin} target="_blank" rel="noopener">{fa ? 'لینکدین ↗' : 'LinkedIn ↗'}</a>
        <a href={SITE.telegram.href} target="_blank" rel="noopener">
          {fa ? 'تلگرام — آگهی‌های شغلی ↗' : 'Telegram — job alerts ↗'}
        </a>
        <a href={`mailto:${SITE.instructor.email}`}>{SITE.instructor.email}</a>
      </div>
    </div>

    <div class="ftr-bot">
      <span>
        {fa
          ? `© ${year} پوریا جهاندیده. همهٔ حقوق محفوظ است.`
          : `© ${year} ${SITE.instructor.name}. All rights reserved.`}
      </span>
      <span class="fnote">
        {fa ? 'از صفر ساخته شده — مثل هر چیز دیگری در این دوره.' : 'Built from scratch — like everything else in this course.'}
      </span>
    </div>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--line); background: var(--ink-800); padding: 3.2rem 0 1.8rem; margin-top: 3rem; }
  .ftr-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.2rem; }
  .fbrand { display: flex; align-items: center; gap: .7rem; margin-bottom: .9rem; }
  .fbrand img { border-radius: 9px; object-fit: cover; }
  .fb-name { font-weight: 800; font-size: .8rem; letter-spacing: .17em; }
  .fb-sub { font-size: .78rem; color: var(--fg-dimmer); }
  .fdesc { font-size: .88rem; color: var(--fg-dimmer); max-width: 34ch; margin: 0; }
  .ftr h4 { font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; color: var(--violet-lt); margin-bottom: .8rem; }
  .ftr-grid a { display: block; font-size: .88rem; color: var(--fg-dim); margin-bottom: .5rem; text-decoration: none; }
  .ftr-grid a:hover { color: var(--gold); }
  .ftr-bot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: .6rem;
    border-top: 1px solid var(--line); margin-top: 2.4rem; padding-top: 1.3rem;
    font-size: .8rem; color: var(--fg-dimmer);
  }
  @media (max-width: 780px) {
    .ftr-grid { grid-template-columns: 1fr 1fr; gap: 1.8rem; }
  }
  @media (max-width: 460px) {
    .ftr-grid { grid-template-columns: 1fr; }
  }
</style>
